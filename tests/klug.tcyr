# klug test suite — the severity lens.
#
# klug's dump path is thin syscall I/O (klug#36 → stdout on agnos, /dev/kmsg on
# the dev host) and is integration-tested via the agnos exec path (`run /bin/klug`
# on a booted kernel — see the agnos iron tracker, item H5). The pure,
# host-testable logic is `klug_level_of`, the lens that decides whether a line
# passes -w/-e; this harness pins it against the kernel's "[I] " / "[W] " /
# "[E] " prefix contract (core/klug.cyr's klug_info/warn/err).

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/assert.cyr"
include "src/klug.cyr"

fn _level(s): i64 {
    return klug_level_of(s, strlen(s));
}

fn test_recognized_prefixes() {
    assert(_level("[E] disk error\n") == KLUG_LVL_ERR, "err prefix -> ERR");
    assert(_level("[W] low memory\n") == KLUG_LVL_WARN, "warn prefix -> WARN");
    assert(_level("[I] booting\n") == KLUG_LVL_ALL, "info prefix -> ALL");
    return 0;
}

fn test_unprefixed_lines_always_show() {
    assert(_level("ext2: mounted\n") == KLUG_LVL_ALL, "plain line -> ALL");
    assert(_level("") == KLUG_LVL_ALL, "empty -> ALL");
    assert(_level("[X] weird\n") == KLUG_LVL_ALL, "unknown level char -> ALL");
    assert(_level("[E]") == KLUG_LVL_ALL, "too short (no body) -> ALL");
    assert(_level("[E") == KLUG_LVL_ALL, "no closing bracket -> ALL");
    return 0;
}

fn _tagged(s): i64 {
    return klug_has_level_tag(s, strlen(s));
}

fn test_tag_presence_is_distinct_from_level() {
    # ⛔ THE WHOLE POINT: klug_level_of CANNOT answer "was there a tag?" — it returns
    # KLUG_LVL_ALL (0) for a real "[I] " AND for an untagged boot line, because both
    # must appear in a bare dump. Without a separate predicate, `klug -w` printing
    # nothing is indistinguishable from a kernel that emits no tags at all — which is
    # exactly what agnos ships today (klug_info/warn/err are all inside #ifdef
    # EXEC_SELFTEST). These two asserts are what make that distinction testable.
    assert(_level("[I] booting\n") == KLUG_LVL_ALL, "info scores level 0 ...");
    assert(_tagged("[I] booting\n") == 1, "... but IS tagged");
    assert(_level("ext2: mounted\n") == KLUG_LVL_ALL, "plain line scores level 0 ...");
    assert(_tagged("ext2: mounted\n") == 0, "... and is NOT tagged");
    return 0;
}

fn test_tag_recognizes_all_three_levels() {
    assert(_tagged("[E] disk error\n") == 1, "[E] is tagged");
    assert(_tagged("[W] low memory\n") == 1, "[W] is tagged");
    assert(_tagged("[I] booting\n") == 1, "[I] is tagged");
    assert(_tagged("[X] weird\n") == 0, "unknown level char is NOT tagged");
    assert(_tagged("[E") == 0, "no closing bracket is NOT tagged");
    assert(_tagged("") == 0, "empty is NOT tagged");
    return 0;
}

fn test_lens_sees_through_the_uptime_prefix() {
    # ⭐ THE ACCEPTANCE RECORD FOR THE agnos 1.56.58 LOG PREFIX. The lens is offset-fixed ([ at byte 0,
    # ] at byte 2), so a prepended uptime field would collapse every line to level 0 and make `klug -w`
    # a silent no-op — nothing printed, exit 0, indistinguishable from "no warnings". agnos 1.56.58
    # ships that prefix (kernel/core/kprint.cyr klog_build_prefix) and klug_time_prefix_len below steps
    # over it. Do not weaken these to "either answer is fine": the whole hazard was that both answers
    # look identical from outside.
    assert(_level("[    4.123456] [W] low memory\n") == KLUG_LVL_WARN, "prefixed [W] -> WARN");
    assert(_level("[    4.123456] [E] disk error\n") == KLUG_LVL_ERR, "prefixed [E] -> ERR");
    assert(_level("[    4.123456] [I] booting\n") == KLUG_LVL_ALL, "prefixed [I] -> ALL");
    assert(_tagged("[    4.123456] [W] low memory\n") == 1, "prefixed [W] is tagged");
    assert(_tagged("[    4.123456] ext2: mounted\n") == 0, "prefixed plain line is NOT tagged");
    return 0;
}

fn test_unprefixed_lines_still_work() {
    # The prefix is OPTIONAL. Kernel lines emitted before the timebase calibrates, ring-3 output
    # (which the kernel deliberately leaves undecorated), and every pre-1.56.58 captured log carry no
    # prefix at all — the lens must be unchanged for them.
    assert(_level("[W] low memory\n") == KLUG_LVL_WARN, "bare [W] still -> WARN");
    assert(_level("[E] disk error\n") == KLUG_LVL_ERR, "bare [E] still -> ERR");
    assert(_tagged("[E] disk error\n") == 1, "bare [E] still tagged");
    return 0;
}

fn test_time_prefix_needs_all_four_anchors() {
    # ⚠ Byte 0 alone would false-positive on a real level line. Each assert breaks exactly one anchor
    # and requires the skip to decline, so a future "simplification" to a single [ test reddens here.
    assert(klug_time_prefix_len("[    4.123456] x", 16) == 15, "well-formed prefix -> 15");
    assert(klug_time_prefix_len("[E] disk error!!", 16) == 0, "a real [E] line is not a prefix");
    assert(klug_time_prefix_len("(    4.123456] x", 16) == 0, "no opening bracket -> 0");
    assert(klug_time_prefix_len("[    4X123456] x", 16) == 0, "no decimal point -> 0");
    assert(klug_time_prefix_len("[    4.123456X x", 16) == 0, "no closing bracket -> 0");
    assert(klug_time_prefix_len("[    4.123456]x ", 16) == 0, "no trailing space -> 0");
    assert(klug_time_prefix_len("[    4.1234", 11) == 0, "too short -> 0");
    return 0;
}

fn test_severity_ordering() {
    # The -w/-e filters rely on this ascending order.
    assert(KLUG_LVL_ALL < KLUG_LVL_WARN, "ALL < WARN");
    assert(KLUG_LVL_WARN < KLUG_LVL_ERR, "WARN < ERR");
    return 0;
}

fn test_ring_size_matches_kernel() {
    # klug_buf in main.cyr (var[8192] = 65536 B) must equal the kernel ring
    # (core/klug.cyr) so a single klug#36 read drains it. Pin the contract.
    # Bumped 16 KB -> 64 KB: the iron boot log (GPU arc + full device enum + SMP)
    # grew past 16 KB, so the old ring wrapped and lost the earliest boot lines.
    assert(KLUG_RING_BYTES == 65536, "ring buffer = 64 KB (kernel klug_buf)");
    # The other leg of the contract. main.cyr declares `var klug_buf[KLUG_RING_WORDS]`
    # and a var[N] is N×u64, so this pins the BUFFER's byte size to the count we hand
    # klug#36 / read(). The harness cannot see klug_buf itself — it includes klug.cyr,
    # not main.cyr — so the shared enum is what makes the check expressible at all.
    assert(KLUG_RING_WORDS * 8 == KLUG_RING_BYTES, "klug_buf bytes = KLUG_RING_BYTES");
    return 0;
}

fn main(): i64 {
    test_group("klug severity lens — recognized prefixes");
    test_recognized_prefixes();
    test_group("klug severity lens — unprefixed / malformed");
    test_unprefixed_lines_always_show();
    test_group("klug tag presence vs level");
    test_tag_presence_is_distinct_from_level();
    test_tag_recognizes_all_three_levels();
    test_group("klug lens sees through the agnos uptime prefix");
    test_lens_sees_through_the_uptime_prefix();
    test_unprefixed_lines_still_work();
    test_time_prefix_needs_all_four_anchors();
    test_group("klug severity ordering");
    test_severity_ordering();
    test_group("klug ring-size contract");
    test_ring_size_matches_kernel();
    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
