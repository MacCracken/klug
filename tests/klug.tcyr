# klug test suite — the severity lens and the write loop.
#
# klug's dump path is thin syscall I/O (klug#36 → stdout on agnos, /dev/kmsg on
# the dev host) and is integration-tested via the agnos exec path (`run /bin/klug`
# on a booted kernel — see the agnos iron tracker, item H5) and, since 0.2.0, by
# CI executing the host binary as root. What is host-testable in-process:
#   · the ring lens, `klug_level_of(.., KLUG_SRC_RING)`, pinned against the kernel's
#     "[I] " / "[W] " / "[E] " prefix contract (core/klug.cyr's klug_info/warn/err);
#   · the /dev/kmsg lens, `klug_level_of(.., KLUG_SRC_KMSG)`, pinned against the
#     dev-kmsg record format (syslog priority, continuation lines);
#   · the write loop, `klug_write_loop`, driven through a scripted fake writer so
#     every short-write / zero / errno arm of BOTH targets' policies runs here —
#     including the agnos backpressure arm, which used to run only on iron;
#   · the /dev/kmsg drain, `klug_kmsg_drain`, driven through a scripted fake reader
#     that refuses a record that does not fit exactly as devkmsg_read does — so a log
#     bigger than the buffer, -EAGAIN / -EPIPE / -EINTR and a failed read all run here.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/assert.cyr"
include "src/klug.cyr"

fn _level(s): i64 {
    return klug_level_of(s, strlen(s), KLUG_SRC_RING);
}

fn test_recognized_prefixes() {
    assert(_level("[E] disk error\n") == KLUG_LVL_ERR, "err prefix -> ERR");
    assert(_level("[W] low memory\n") == KLUG_LVL_WARN, "warn prefix -> WARN");
    assert(_level("[I] booting\n") == KLUG_LVL_ALL, "info prefix -> ALL");
    return 0;
}

fn test_unprefixed_lines_always_show() {
    assert(_level("ext2: mounted\n") == KLUG_LVL_ALL, "plain line -> ALL");
    assert(_level("") == KLUG_LVL_ALL, "empty -> ALL");
    assert(_level("[X] weird\n") == KLUG_LVL_ALL, "unknown level char -> ALL");
    assert(_level("[E]") == KLUG_LVL_ALL, "too short (no body) -> ALL");
    assert(_level("[E") == KLUG_LVL_ALL, "no closing bracket -> ALL");
    return 0;
}

fn _tagged(s): i64 {
    return klug_has_level_tag(s, strlen(s), KLUG_SRC_RING);
}

fn test_tag_presence_is_distinct_from_level() {
    # ⛔ THE WHOLE POINT: klug_level_of CANNOT answer "was there a tag?" — it returns
    # KLUG_LVL_ALL (0) for a real "[I] " AND for an untagged boot line, because both
    # must appear in a bare dump. Without a separate predicate, `klug -w` printing
    # nothing is indistinguishable from a kernel that emits no tags at all — which is
    # exactly what agnos ships today (klug_info/warn/err are all inside #ifdef
    # EXEC_SELFTEST). These two asserts are what make that distinction testable.
    assert(_level("[I] booting\n") == KLUG_LVL_ALL, "info scores level 0 ...");
    assert(_tagged("[I] booting\n") == 1, "... but IS tagged");
    assert(_level("ext2: mounted\n") == KLUG_LVL_ALL, "plain line scores level 0 ...");
    assert(_tagged("ext2: mounted\n") == 0, "... and is NOT tagged");
    return 0;
}

fn test_tag_recognizes_all_three_levels() {
    assert(_tagged("[E] disk error\n") == 1, "[E] is tagged");
    assert(_tagged("[W] low memory\n") == 1, "[W] is tagged");
    assert(_tagged("[I] booting\n") == 1, "[I] is tagged");
    assert(_tagged("[X] weird\n") == 0, "unknown level char is NOT tagged");
    assert(_tagged("[E") == 0, "no closing bracket is NOT tagged");
    assert(_tagged("") == 0, "empty is NOT tagged");
    return 0;
}

fn test_lens_sees_through_the_uptime_prefix() {
    # ⭐ THE ACCEPTANCE RECORD FOR THE agnos 1.56.58 LOG PREFIX. The lens is offset-fixed ([ at byte 0,
    # ] at byte 2), so a prepended uptime field would collapse every line to level 0 and make `klug -w`
    # a silent no-op — nothing printed, exit 0, indistinguishable from "no warnings". agnos 1.56.58
    # ships that prefix (kernel/core/kprint.cyr klog_build_prefix) and klug_time_prefix_len below steps
    # over it. Do not weaken these to "either answer is fine": the whole hazard was that both answers
    # look identical from outside.
    assert(_level("[    4.123456] [W] low memory\n") == KLUG_LVL_WARN, "prefixed [W] -> WARN");
    assert(_level("[    4.123456] [E] disk error\n") == KLUG_LVL_ERR, "prefixed [E] -> ERR");
    assert(_level("[    4.123456] [I] booting\n") == KLUG_LVL_ALL, "prefixed [I] -> ALL");
    assert(_tagged("[    4.123456] [W] low memory\n") == 1, "prefixed [W] is tagged");
    assert(_tagged("[    4.123456] ext2: mounted\n") == 0, "prefixed plain line is NOT tagged");
    return 0;
}

fn test_unprefixed_lines_still_work() {
    # The prefix is OPTIONAL. Kernel lines emitted before the timebase calibrates, ring-3 output
    # (which the kernel deliberately leaves undecorated), and every pre-1.56.58 captured log carry no
    # prefix at all — the lens must be unchanged for them.
    assert(_level("[W] low memory\n") == KLUG_LVL_WARN, "bare [W] still -> WARN");
    assert(_level("[E] disk error\n") == KLUG_LVL_ERR, "bare [E] still -> ERR");
    assert(_tagged("[E] disk error\n") == 1, "bare [E] still tagged");
    return 0;
}

fn test_time_prefix_needs_all_four_anchors() {
    # ⚠ Byte 0 alone would false-positive on a real level line. Each assert breaks exactly one anchor
    # and requires the skip to decline, so a future "simplification" to a single [ test reddens here.
    assert(klug_time_prefix_len("[    4.123456] x", 16) == 15, "well-formed prefix -> 15");
    assert(klug_time_prefix_len("[E] disk error!!", 16) == 0, "a real [E] line is not a prefix");
    assert(klug_time_prefix_len("(    4.123456] x", 16) == 0, "no opening bracket -> 0");
    assert(klug_time_prefix_len("[    4X123456] x", 16) == 0, "no decimal point -> 0");
    assert(klug_time_prefix_len("[    4.123456X x", 16) == 0, "no closing bracket -> 0");
    assert(klug_time_prefix_len("[    4.123456]x ", 16) == 0, "no trailing space -> 0");
    assert(klug_time_prefix_len("[    4.1234", 11) == 0, "too short -> 0");
    return 0;
}

fn test_severity_ordering() {
    # The -w/-e filters rely on this ascending order.
    assert(KLUG_LVL_ALL < KLUG_LVL_WARN, "ALL < WARN");
    assert(KLUG_LVL_WARN < KLUG_LVL_ERR, "WARN < ERR");
    return 0;
}

fn test_ring_size_matches_kernel() {
    # klug_buf in main.cyr (var[8192] = 65536 B) must equal the kernel ring
    # (core/klug.cyr) so a single klug#36 read drains it. Pin the contract.
    # Bumped 16 KB -> 64 KB: the iron boot log (GPU arc + full device enum + SMP)
    # grew past 16 KB, so the old ring wrapped and lost the earliest boot lines.
    assert(KLUG_RING_BYTES == 65536, "ring buffer = 64 KB (kernel klug_buf)");
    # The other leg of the contract. main.cyr declares `var klug_buf[KLUG_RING_WORDS]`
    # and a var[N] is N×u64, so this pins the BUFFER's byte size to the count we hand
    # klug#36 / read(). The harness cannot see klug_buf itself — it includes klug.cyr,
    # not main.cyr — so the shared enum is what makes the check expressible at all.
    assert(KLUG_RING_WORDS * 8 == KLUG_RING_BYTES, "klug_buf bytes = KLUG_RING_BYTES");
    return 0;
}

# ── /dev/kmsg lens ───────────────────────────────────────────────────────────────

fn _klevel(s): i64 {
    return klug_level_of(s, strlen(s), KLUG_SRC_KMSG);
}

fn _ktagged(s): i64 {
    return klug_has_level_tag(s, strlen(s), KLUG_SRC_KMSG);
}

fn _kpri(s): i64 {
    return klug_kmsg_pri_level(s, strlen(s));
}

fn _kline(s, prev): i64 {
    return klug_line_level(s, strlen(s), KLUG_SRC_KMSG, prev);
}

fn _rline(s, prev): i64 {
    return klug_line_level(s, strlen(s), KLUG_SRC_RING, prev);
}

fn test_kmsg_priority_maps_to_level() {
    # syslog level = pri & 7: 0 emerg · 1 alert · 2 crit · 3 err · 4 warning · 5 notice · 6 info ·
    # 7 debug. -e keeps <= 3, -w keeps <= 4 — the same slice `dmesg --level` makes.
    assert(_klevel("0,1,2,-;emerg\n") == KLUG_LVL_ERR, "emerg (0) -> ERR");
    assert(_klevel("1,1,2,-;alert\n") == KLUG_LVL_ERR, "alert (1) -> ERR");
    assert(_klevel("2,1,2,-;crit\n") == KLUG_LVL_ERR, "crit (2) -> ERR");
    assert(_klevel("3,100,123456,-;disk error\n") == KLUG_LVL_ERR, "err (3) -> ERR");
    assert(_klevel("4,100,123456,-;low memory\n") == KLUG_LVL_WARN, "warning (4) -> WARN");
    assert(_klevel("5,1,2,-;notice\n") == KLUG_LVL_ALL, "notice (5) -> ALL");
    assert(_klevel("6,339,5140900,-;NET: Registered protocol family 10\n") == KLUG_LVL_ALL, "info (6) -> ALL");
    assert(_klevel("7,1,2,-;debug\n") == KLUG_LVL_ALL, "debug (7) -> ALL");
    return 0;
}

fn test_kmsg_facility_bits_are_ignored() {
    # A userspace writer to /dev/kmsg carries its facility in the high bits (user = 1<<3, local7 =
    # 23<<3). The LEVEL is the low three bits regardless — "12," is user.warning, still a warning.
    assert(_klevel("12,1,2,-;user.warning\n") == KLUG_LVL_WARN, "12 (user.warning) -> WARN");
    assert(_klevel("11,1,2,-;user.err\n") == KLUG_LVL_ERR, "11 (user.err) -> ERR");
    assert(_klevel("14,1,2,-;user.info\n") == KLUG_LVL_ALL, "14 (user.info) -> ALL");
    assert(_klevel("188,1,2,-;local7.warning\n") == KLUG_LVL_WARN, "188 (local7.warning) -> WARN");
    assert(_klevel("191,1,2,-;local7.debug\n") == KLUG_LVL_ALL, "191 (local7.debug) -> ALL");
    return 0;
}

fn test_kmsg_not_a_record_is_untagged() {
    # The primitive says -1 for anything that is not "<digits>,"; the lens turns that into ALL
    # (shown in a bare dump, dropped by a filter) and the tag predicate into 0 — the same rule the
    # ring applies to an untagged boot line, so the "matched nothing because nothing is tagged"
    # note keeps working on this source.
    assert(_kpri("") == 0 - 1, "empty -> not a record");
    assert(_kpri("abc\n") == 0 - 1, "no leading digits -> not a record");
    assert(_kpri("3;msg\n") == 0 - 1, "digits but no comma -> not a record");
    assert(_kpri(",3,1,2,-;x\n") == 0 - 1, "comma first -> not a record");
    assert(_kpri("3") == 0 - 1, "digits to the end (no comma) -> not a record");
    assert(_kpri("12345678901,x\n") == 0 - 1, "11 digits -> not a priority");
    assert(_kpri("1234567890,x\n") >= 0, "10 digits is still parsed (cap is 10)");
    assert(_klevel("abc\n") == KLUG_LVL_ALL, "not a record -> ALL");
    assert(_ktagged("abc\n") == 0, "not a record -> NOT tagged");
    assert(_ktagged("") == 0, "empty -> NOT tagged");
    assert(_ktagged("6,1,2,-;x\n") == 1, "an info record IS tagged (level 0, but present)");
    assert(_ktagged("3,1,2,-;x\n") == 1, "an err record is tagged");
    return 0;
}

fn test_kmsg_continuation_lines_inherit_their_record() {
    # The kernel appends " KEY=VALUE" dictionary lines to dev_printk records (" SUBSYSTEM=usb",
    # " DEVICE=+usb:1-2"). They carry no priority; per line they would score ALL and `klug -e`
    # would strip an error's context. klug_line_level hands them the previous header's level.
    assert(_kline(" SUBSYSTEM=usb\n", KLUG_LVL_ERR) == KLUG_LVL_ERR, "continuation after an err -> ERR");
    assert(_kline(" DEVICE=+usb:1-2\n", KLUG_LVL_WARN) == KLUG_LVL_WARN, "continuation after a warning -> WARN");
    assert(_kline(" SUBSYSTEM=usb\n", KLUG_LVL_ALL) == KLUG_LVL_ALL, "continuation after info -> ALL");
    # A header never inherits: its own priority wins over whatever came before.
    assert(_kline("6,1,2,-;x\n", KLUG_LVL_ERR) == KLUG_LVL_ALL, "info header after an err -> ALL (own priority)");
    assert(_kline("3,1,2,-;x\n", KLUG_LVL_ALL) == KLUG_LVL_ERR, "err header after info -> ERR (own priority)");
    # Not a record and not a continuation: plain ALL, prev is not consulted.
    assert(_kline("garbage\n", KLUG_LVL_ERR) == KLUG_LVL_ALL, "garbage after an err -> ALL");
    assert(_kline("", KLUG_LVL_ERR) == KLUG_LVL_ALL, "empty after an err -> ALL");
    return 0;
}

fn test_lens_is_per_source_not_per_byte() {
    # ⛔ THE REASON THE LENS TAKES A SOURCE. The same bytes mean different things on the two logs:
    # "3,1,2,-;x" is an alert-level record on /dev/kmsg and a ring-3 program's CSV line on agnos.
    # A lens that sniffed the bytes would make `klug -e` on agnos surface every program that ever
    # printed a number and a comma. Each source applies ONLY its own rule.
    assert(_klevel("3,1,2,-;x\n") == KLUG_LVL_ERR, "KMSG: '3,' is an err record");
    assert(_level("3,1,2,-;x\n") == KLUG_LVL_ALL, "RING: '3,' is just a line");
    assert(_ktagged("3,1,2,-;x\n") == 1, "KMSG: tagged");
    assert(_tagged("3,1,2,-;x\n") == 0, "RING: NOT tagged");
    # And the ring's tag means nothing on /dev/kmsg — a record's message is behind its header.
    assert(_klevel("[E] disk error\n") == KLUG_LVL_ALL, "KMSG: a bare [E] line is not a record -> ALL");
    assert(_ktagged("[E] disk error\n") == 0, "KMSG: a bare [E] line is NOT tagged");
    assert(_level("[E] disk error\n") == KLUG_LVL_ERR, "RING: [E] -> ERR (unchanged)");
    # A leading space is a continuation ONLY on /dev/kmsg. Ring-3 output that indents itself is
    # not continuing the kernel line above it.
    assert(_rline("  indented ring-3 output\n", KLUG_LVL_ERR) == KLUG_LVL_ALL, "RING: leading space never inherits");
    assert(_rline("[E] x\n", KLUG_LVL_ALL) == KLUG_LVL_ERR, "RING: line_level is level_of");
    assert(KLUG_SRC_RING != KLUG_SRC_KMSG, "the two sources are distinct");
    return 0;
}

# ── write loop ───────────────────────────────────────────────────────────────────
#
# A scripted fake writer stands in for `write(1, …)`. Per call it returns the next scripted
# value (a short count, 0, or a negative errno); past the end of the script it accepts
# everything offered. Every accepted byte is copied into a sink so the test can prove the
# loop advanced `p` and shrank `len` by exactly what was accepted — the arithmetic that,
# if wrong, ships a dump with a hole in it and exit 0.

var _wr_script[32];      # scripted return values, one per call
var _wr_script_len = 0;
var _wr_const_on = 0;    # 1: ignore the script, return _wr_const on EVERY call
var _wr_const = 0;
var _wr_calls = 0;
var _wr_base = 0;        # the buffer the loop was handed
var _wr_total = 0;
var _wr_sink[128];       # accepted bytes, in order (1 KB)
var _wr_sunk = 0;
var _wr_bad_offer = 0;   # set if any call's (p, len) was not exactly (base + sunk, total - sunk), or len <= 0
var _wr_strict = 1;      # 0: skip the offer check (emit tests write several sub-ranges of one log)
var _wr_src[128];        # 1 KB source pattern

fn _wr_fill(n): i64 {
    var i = 0;
    while (i < n) { store8(&_wr_src + i, 65 + (i % 26)); i = i + 1; }
    return 0;
}

fn _wr_reset(total): i64 {
    _wr_fill(total);
    memset(&_wr_sink, 0, 1024);
    _wr_script_len = 0; _wr_const_on = 0; _wr_const = 0; _wr_calls = 0;
    _wr_base = &_wr_src; _wr_total = total; _wr_sunk = 0; _wr_bad_offer = 0; _wr_strict = 1;
    return 0;
}

fn _wr_push(r): i64 {
    store64(&_wr_script + _wr_script_len * 8, r);
    _wr_script_len = _wr_script_len + 1;
    return 0;
}

fn _wr_always(r): i64 {
    _wr_const_on = 1;
    _wr_const = r;
    return 0;
}

fn _fake_writer(p, len): i64 {
    if (_wr_strict == 1) {
        if (p != _wr_base + _wr_sunk) { _wr_bad_offer = 1; }
        if (len != _wr_total - _wr_sunk) { _wr_bad_offer = 1; }
    }
    if (len <= 0) { _wr_bad_offer = 1; }
    var i = _wr_calls;
    _wr_calls = _wr_calls + 1;
    var r = len;                                        # past the script: accept everything
    if (_wr_const_on == 1) { r = _wr_const; }
    else { if (i < _wr_script_len) { r = load64(&_wr_script + i * 8); } }
    if (r > len) { r = len; }                           # a script cannot accept more than offered
    if (r > 0) { memcpy(&_wr_sink + _wr_sunk, p, r); _wr_sunk = _wr_sunk + r; }
    return r;
}

fn _wr_run(mode): i64 {
    return klug_write_loop(&_fake_writer, mode, &_wr_src, _wr_total);
}

fn _wr_delivered_all(): i64 {
    if (_wr_sunk != _wr_total) { return 0; }
    if (_wr_bad_offer != 0) { return 0; }
    return memeq(&_wr_sink, &_wr_src, _wr_total);
}

fn test_write_loop_loops_over_short_writes() {
    # The 0.1.5 bug: one write(1, buf, 65536) accepted 4080 bytes and klug exited 0. The loop
    # must keep offering the unsent tail — at exactly the right offset — until it is all gone.
    _wr_reset(300); _wr_push(100); _wr_push(50); _wr_push(150);
    assert_eq(_wr_run(KLUG_WR_LINUX), 0, "linux: three short writes -> 0");
    assert_eq(_wr_calls, 3, "linux: one call per short write");
    assert_eq(_wr_delivered_all(), 1, "linux: every byte delivered once, in order, from the right offset");
    _wr_reset(300); _wr_push(100); _wr_push(50); _wr_push(150);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 0, "agnos: three short writes -> 0");
    assert_eq(_wr_calls, 3, "agnos: one call per short write");
    assert_eq(_wr_delivered_all(), 1, "agnos: every byte delivered once, in order, from the right offset");
    # A 4080-byte cap on a 4096-byte offer, the exact agnos pipe_write shape, scaled to the sink.
    _wr_reset(500); _wr_push(408); _wr_push(408);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 0, "agnos: pipe-cap shape -> 0");
    assert_eq(_wr_calls, 2, "agnos: 408 + 92 (second offer capped by the remainder)");
    assert_eq(_wr_delivered_all(), 1, "agnos: nothing lost past the cap");
    return 0;
}

fn test_write_loop_full_write_is_one_call() {
    _wr_reset(300);
    assert_eq(_wr_run(KLUG_WR_LINUX), 0, "linux: full write -> 0");
    assert_eq(_wr_calls, 1, "linux: full write is exactly one call");
    assert_eq(_wr_delivered_all(), 1, "linux: full write delivered");
    return 0;
}

fn test_write_loop_zero_length_never_writes() {
    # An empty run must not issue write(1, p, 0): the loop condition, not the writer, ends it.
    _wr_reset(0);
    assert_eq(_wr_run(KLUG_WR_LINUX), 0, "linux: len 0 -> 0");
    assert_eq(_wr_calls, 0, "linux: len 0 -> no write at all");
    _wr_reset(0);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 0, "agnos: len 0 -> 0");
    assert_eq(_wr_calls, 0, "agnos: len 0 -> no write at all");
    return 0;
}

fn test_write_loop_linux_eintr_retries() {
    # -EINTR is the one negative the Linux arm retries (belt-and-braces: klug installs no
    # handlers). The retry must re-offer the SAME tail, not skip ahead.
    _wr_reset(300); _wr_push(100); _wr_push(KLUG_EINTR); _wr_push(KLUG_EINTR); _wr_push(200);
    assert_eq(_wr_run(KLUG_WR_LINUX), 0, "linux: two EINTRs then progress -> 0");
    assert_eq(_wr_calls, 4, "linux: each EINTR costs one retry");
    assert_eq(_wr_delivered_all(), 1, "linux: EINTR retry re-offers the same tail");
    return 0;
}

fn test_write_loop_linux_zero_is_fatal() {
    # On Linux a 0 from write(2) on a non-empty offer is pathological — fail, do not spin.
    _wr_reset(300); _wr_push(100); _wr_push(0);
    assert_eq(_wr_run(KLUG_WR_LINUX), 1, "linux: 0 -> 1");
    assert_eq(_wr_calls, 2, "linux: 0 stops the loop immediately");
    assert_eq(_wr_sunk, 100, "linux: the partial count is what reached the fd");
    return 0;
}

fn test_write_loop_linux_other_errno_is_fatal() {
    # -EAGAIN (11): a non-blocking stdout (measured: 4095 of 52500 bytes, exit 0, before 0.1.5).
    # Anything but -EINTR is fatal — and reported, which is what turns exit 0 into exit 1.
    _wr_reset(300); _wr_push(100); _wr_push(0 - 11);
    assert_eq(_wr_run(KLUG_WR_LINUX), 1, "linux: -EAGAIN -> 1");
    assert_eq(_wr_calls, 2, "linux: -EAGAIN stops the loop immediately");
    _wr_reset(300); _wr_push(0 - 32);
    assert_eq(_wr_run(KLUG_WR_LINUX), 1, "linux: -EPIPE -> 1");
    assert_eq(_wr_calls, 1, "linux: -EPIPE stops the loop immediately");
    return 0;
}

fn test_write_loop_agnos_zero_is_backpressure() {
    # On agnos a 0 is the pipe ring saying "consumer not scheduled yet": yield, re-offer the same
    # tail, and carry on when it drains. This arm ran only on iron before 0.2.0.
    _wr_reset(300); _wr_push(100); _wr_push(0); _wr_push(0); _wr_push(200);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 0, "agnos: two zeros then progress -> 0");
    assert_eq(_wr_calls, 4, "agnos: each zero costs one yield + retry");
    assert_eq(_wr_delivered_all(), 1, "agnos: the retry after backpressure re-offers the same tail");
    return 0;
}

fn test_write_loop_agnos_negative_is_fatal() {
    # agnos has no EINTR: any negative is a real error (bad fd / write end closed) — stop.
    _wr_reset(300); _wr_push(100); _wr_push(0 - 1);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 1, "agnos: -1 -> 1");
    assert_eq(_wr_calls, 2, "agnos: -1 stops the loop immediately");
    assert_eq(_wr_sunk, 100, "agnos: the partial count is what reached the fd");
    _wr_reset(300); _wr_push(KLUG_EINTR);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 1, "agnos: even -4 is fatal (no EINTR on agnos)");
    assert_eq(_wr_calls, 1, "agnos: -4 stops the loop immediately");
    return 0;
}

fn test_write_loop_agnos_stall_is_bounded() {
    # `klug | head`: the consumer is gone, the pipe never drains, agnos gives the writer no
    # reader-gone signal. Without the bound klug hangs forever. The bound is KLUG_STALL_MAX
    # consecutive no-progress calls; the call that finds the counter AT the bound fails, so
    # exactly MAX + 1 calls are made. Run at a small bound for precision ...
    var saved = KLUG_STALL_MAX;
    KLUG_STALL_MAX = 5;
    _wr_reset(300); _wr_always(0);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 1, "agnos: a consumer that never drains -> 1");
    assert_eq(_wr_calls, 6, "agnos: exactly KLUG_STALL_MAX + 1 attempts");
    assert_eq(_wr_sunk, 0, "agnos: nothing was delivered");
    KLUG_STALL_MAX = saved;
    # ... and once at the SHIPPED bound, so the constant is proven finite, not just declared.
    _wr_reset(300); _wr_always(0);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 1, "agnos: production bound terminates -> 1");
    assert_eq(_wr_calls, KLUG_STALL_MAX + 1, "agnos: production bound is KLUG_STALL_MAX + 1 attempts");
    return 0;
}

fn test_write_loop_agnos_stall_resets_on_progress() {
    # The bound is on CONSECUTIVE stalls. A slow consumer that drains a little now and then must
    # never trip it, however long the dump — only a consumer that stops draining does. With
    # MAX = 3, three zeros are under the bound; a fourth without progress in between is not.
    var saved = KLUG_STALL_MAX;
    KLUG_STALL_MAX = 3;
    _wr_reset(300);
    _wr_push(0); _wr_push(0); _wr_push(0); _wr_push(1);
    _wr_push(0); _wr_push(0); _wr_push(0); _wr_push(1);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 0, "agnos: 3 stalls, progress, 3 stalls, progress -> 0");
    assert_eq(_wr_calls, 9, "agnos: 8 scripted calls + the final full write");
    assert_eq(_wr_delivered_all(), 1, "agnos: slow consumer still gets every byte");
    # Control: the same run with one stall too many in the second burst trips the bound.
    _wr_reset(300);
    _wr_push(0); _wr_push(0); _wr_push(0); _wr_push(1);
    _wr_push(0); _wr_push(0); _wr_push(0); _wr_push(0);
    assert_eq(_wr_run(KLUG_WR_AGNOS), 1, "agnos: a fourth consecutive stall trips the bound");
    assert_eq(_wr_calls, 8, "agnos: tripped on the 4th stall of the second burst");
    KLUG_STALL_MAX = saved;
    return 0;
}

fn test_write_loop_production_constants() {
    assert_eq(KLUG_STALL_MAX, 100000, "shipped stall bound is 100000 yields");
    assert_eq(KLUG_EINTR, 0 - 4, "EINTR is -4");
    assert(KLUG_WR_LINUX != KLUG_WR_AGNOS, "the two policies are distinct");
    return 0;
}

# ── emit: the filter over a whole log, byte-exact ────────────────────────────────
#
# klug_emit is everything klug_dump does after the read. Driven here with a synthetic log
# and the fake writer: the sink is "what reached stdout", so each test states the exact
# bytes a flag must produce, and the call count pins the run coalescing (adjacent passing
# lines go out in ONE write).

fn _emit(min_level, log, src): i64 {
    _wr_reset(0);
    _wr_strict = 0;
    return klug_emit(min_level, log, strlen(log), src, &_fake_writer, KLUG_WR_LINUX);
}

fn _sink_is(expected): i64 {
    var n = strlen(expected);
    if (_wr_sunk != n) { return 0; }
    return memeq(&_wr_sink, expected, n);
}

var _cat_buf[64];        # 512 B: a test log assembled from two literals, so no line passes 120 columns

fn _cat(a, b): i64 {
    var na = strlen(a);
    memset(&_cat_buf, 0, 512);
    memcpy(&_cat_buf, a, na);
    memcpy(&_cat_buf + na, b, strlen(b));
    return &_cat_buf;
}

fn test_emit_unfiltered_is_one_write_of_everything() {
    var log = "6,1,100,-;boot ok\n3,2,200,-;disk error\n SUBSYSTEM=block\n4,3,300,-;low memory\n";
    assert_eq(_emit(KLUG_LVL_ALL, log, KLUG_SRC_KMSG), 0, "bare dump -> 0");
    assert_eq(_wr_calls, 1, "bare dump is ONE write, no per-line work");
    assert_eq(_sink_is(log), 1, "bare dump is the log, byte for byte");
    assert_eq(_emit(KLUG_LVL_ALL, "", KLUG_SRC_KMSG), 0, "empty log -> 0");
    assert_eq(_wr_calls, 0, "empty log writes nothing");
    return 0;
}

fn test_emit_kmsg_err_keeps_a_record_with_its_continuations() {
    # -e over a /dev/kmsg log: the err record AND its dictionary lines, nothing else. The
    # continuation state is threaded through the loop here — a per-line lens alone would
    # drop " SUBSYSTEM=block" as level 0 and hand the operator an error with no device.
    var log = _cat("6,1,100,-;boot ok\n3,2,200,-;disk error\n SUBSYSTEM=block\n DEVICE=+block:sda\n",
      "4,3,300,-;low memory\n6,4,400,-;fine\n");
    assert_eq(_emit(KLUG_LVL_ERR, log, KLUG_SRC_KMSG), 0, "-e -> 0");
    assert_eq(_sink_is("3,2,200,-;disk error\n SUBSYSTEM=block\n DEVICE=+block:sda\n"), 1,
      "-e: the err record + both continuations, nothing else");
    assert_eq(_wr_calls, 1, "-e: one contiguous run -> one write");
    return 0;
}

fn test_emit_kmsg_warn_coalesces_adjacent_passing_lines() {
    # -w: err + warning records. An info record between two passing runs splits them into
    # two writes; adjacent passing lines (a record and its continuation, or two records in a
    # row) go out together.
    var log = _cat("6,1,100,-;boot ok\n3,2,200,-;disk error\n SUBSYSTEM=block\n6,3,300,-;fine\n",
      "4,4,400,-;low memory\n4,5,500,-;still low\n6,6,600,-;fine again\n");
    assert_eq(_emit(KLUG_LVL_WARN, log, KLUG_SRC_KMSG), 0, "-w -> 0");
    assert_eq(_sink_is("3,2,200,-;disk error\n SUBSYSTEM=block\n4,4,400,-;low memory\n4,5,500,-;still low\n"), 1,
      "-w: err+continuation, then both warnings; infos dropped");
    assert_eq(_wr_calls, 2, "-w: two runs (split by the info record) -> two writes");
    # A continuation after a DROPPED record is dropped with it.
    var log2 = "6,1,100,-;usb 1-2: new device\n SUBSYSTEM=usb\n DEVICE=+usb:1-2\n4,2,200,-;low memory\n";
    assert_eq(_emit(KLUG_LVL_WARN, log2, KLUG_SRC_KMSG), 0, "-w (info+continuations) -> 0");
    assert_eq(_sink_is("4,2,200,-;low memory\n"), 1, "-w: an info record's continuations go with it");
    return 0;
}

fn test_emit_ring_warn_is_the_agnos_lens() {
    # The same loop under the ring source: [W]/[E] pass (prefixed or not), plain kprintln and
    # ring-3 lines drop, and a leading space is NOT a continuation here.
    var log = _cat("[    1.000000] [I] booting\n[W] low memory\nplain kprintln line\n  indented ring-3 output\n",
      "[    5.000000] [E] disk error\n[E] again\n");
    assert_eq(_emit(KLUG_LVL_WARN, log, KLUG_SRC_RING), 0, "ring -w -> 0");
    assert_eq(_sink_is("[W] low memory\n[    5.000000] [E] disk error\n[E] again\n"), 1,
      "ring -w: the [W] and both [E]s, plain + indented lines dropped");
    assert_eq(_wr_calls, 2, "ring -w: two runs -> two writes");
    assert_eq(_emit(KLUG_LVL_ERR, log, KLUG_SRC_RING), 0, "ring -e -> 0");
    assert_eq(_sink_is("[    5.000000] [E] disk error\n[E] again\n"), 1, "ring -e: only the [E]s");
    assert_eq(_wr_calls, 1, "ring -e: adjacent [E]s -> one write");
    return 0;
}

fn test_emit_trailing_partial_line_is_filtered_too() {
    # A log that does not end in a newline (a ring cut mid-line, or a record without its
    # terminator): the trailing fragment goes through the same lens and the same run.
    var log = "6,1,100,-;boot ok\n3,2,200,-;disk error\n SUBSYSTEM=block";
    assert_eq(_emit(KLUG_LVL_ERR, log, KLUG_SRC_KMSG), 0, "-e with a partial tail -> 0");
    assert_eq(_sink_is("3,2,200,-;disk error\n SUBSYSTEM=block"), 1,
      "-e: the partial continuation inherits and is kept");
    assert_eq(_wr_calls, 1, "-e: record + partial continuation -> one write");
    var log2 = "3,1,100,-;disk error\n6,2,200,-;fine";
    assert_eq(_emit(KLUG_LVL_ERR, log2, KLUG_SRC_KMSG), 0, "-e with a dropped partial tail -> 0");
    assert_eq(_sink_is("3,1,100,-;disk error\n"), 1, "-e: a partial info tail is dropped");
    return 0;
}

fn test_emit_nothing_selected_is_still_exit_zero() {
    # A ring with no tagged lines under -w: nothing written, exit 0 — and the "matched nothing
    # because nothing is tagged" note goes to stderr (it prints during this test; it is not
    # captured, the exit code and the empty stdout are what is asserted).
    var log = "plain boot line\nanother plain line\n";
    assert_eq(_emit(KLUG_LVL_WARN, log, KLUG_SRC_RING), 0, "nothing selected -> still 0");
    assert_eq(_wr_calls, 0, "nothing selected -> nothing written");
    return 0;
}

fn test_emit_write_failure_stops_and_reports_one() {
    # Three runs under -w; the writer accepts the first and fails the second. The emit must
    # return 1 and NOT keep writing runs past a failed one (a hole in the middle of a dump
    # that then exits 0 is the 0.1.5 shape again).
    var log = "4,1,100,-;w1\n6,2,200,-;i\n4,3,300,-;w2\n6,4,400,-;i\n4,5,500,-;w3\n";
    _wr_reset(0);
    _wr_strict = 0;
    _wr_push(11);                                       # "4,1,100,-;w1\n" is 13 bytes: short by 2, then fail
    _wr_push(0 - 32);                                   # -EPIPE on the retry
    var rc = klug_emit(KLUG_LVL_WARN, log, strlen(log), KLUG_SRC_KMSG, &_fake_writer, KLUG_WR_LINUX);
    assert_eq(rc, 1, "write failure -> 1");
    assert_eq(_wr_calls, 2, "write failure: no further runs are attempted");
    assert_eq(_wr_sunk, 11, "write failure: only the accepted prefix reached stdout");
    return 0;
}

# ── /dev/kmsg drain: the whole log, batch by batch ───────────────────────────────
#
# A scripted fake reader stands in for read(/dev/kmsg). Each call returns the next step: a
# record (copied into the offered buffer — or refused with -EINVAL when it does not fit, which is
# what devkmsg_read does) or a negative errno (0 is returned as-is). Past the script it returns
# -EAGAIN: caught up. The output side is the fake writer, so each test states the exact stdout
# bytes. The drain runs on a 96-byte buffer with KLUG_KMSG_REC_MAX lowered to 32, so a batch is
# flushed once more than 64 bytes are in it — 5 of the 13-byte records below.

var _rd_script[32];      # per call: a record (cstring pointer) or an errno (<= 0)
var _rd_len = 0;
var _rd_const_on = 0;    # 1: ignore the script, return _rd_const on EVERY call
var _rd_const = 0;
var _rd_calls = 0;
var _rd_min_offer = 0;   # the smallest `len` any read was offered
var _rd_bad_fd = 0;      # set if a read went to any fd but the one the drain was handed
var _rd_buf[12];         # the drain's 96-byte batch buffer
var _rd_all[64];         # 512 B: every scripted record, in order — what a bare dump must print
var _rd_all_len = 0;

fn _rd_reset(): i64 {
    _wr_reset(0);
    _wr_strict = 0;
    _rd_len = 0; _rd_const_on = 0; _rd_const = 0; _rd_calls = 0;
    _rd_min_offer = 1000000; _rd_bad_fd = 0; _rd_all_len = 0;
    memset(&_rd_all, 0, 512);
    return 0;
}

fn _rd_push(step): i64 {
    store64(&_rd_script + _rd_len * 8, step);
    _rd_len = _rd_len + 1;
    if (step > 0) {
        var n = strlen(step);
        memcpy(&_rd_all + _rd_all_len, step, n);
        _rd_all_len = _rd_all_len + n;
    }
    return 0;
}

fn _rd_always(r): i64 {
    _rd_const_on = 1;
    _rd_const = r;
    return 0;
}

fn _fake_reader(fd, p, len): i64 {
    if (fd != 7) { _rd_bad_fd = 1; }
    if (len < _rd_min_offer) { _rd_min_offer = len; }
    var i = _rd_calls;
    _rd_calls = _rd_calls + 1;
    var step = KLUG_EAGAIN;                             # past the script: caught up
    if (_rd_const_on == 1) { step = _rd_const; }
    else { if (i < _rd_len) { step = load64(&_rd_script + i * 8); } }
    if (step <= 0) { return step; }
    var n = strlen(step);
    if (n > len) { return 0 - 22; }                     # -EINVAL: devkmsg_read refuses (and loses) it
    memcpy(p, step, n);
    return n;
}

fn _drain(min_level): i64 {
    var saved = KLUG_KMSG_REC_MAX;
    KLUG_KMSG_REC_MAX = 32;
    var rc = klug_kmsg_drain(&_fake_reader, 7, &_rd_buf, 96, min_level, &_fake_writer, KLUG_WR_LINUX);
    KLUG_KMSG_REC_MAX = saved;
    return rc;
}

# The first `n` bytes of the scripted records — and nothing else — reached stdout.
fn _sink_is_first(n): i64 {
    if (_wr_sunk != n) { return 0; }
    return memeq(&_wr_sink, &_rd_all, n);
}

fn _rd_twelve(): i64 {   # twelve 13-byte info records: 156 B, more than the 96-byte buffer
    _rd_push("6,1,10,-;a01\n"); _rd_push("6,1,10,-;a02\n"); _rd_push("6,1,10,-;a03\n");
    _rd_push("6,1,10,-;a04\n"); _rd_push("6,1,10,-;a05\n"); _rd_push("6,1,10,-;a06\n");
    _rd_push("6,1,10,-;a07\n"); _rd_push("6,1,10,-;a08\n"); _rd_push("6,1,10,-;a09\n");
    _rd_push("6,1,10,-;a10\n"); _rd_push("6,1,10,-;a11\n"); _rd_push("6,1,10,-;a12\n");
    return 0;
}

fn test_drain_dumps_a_log_bigger_than_the_buffer() {
    # ⛔ THE 0.2.1 FIX. Through 0.2.0 the Linux arm read until its buffer was full and stopped: on a
    # host whose /dev/kmsg held more than 64 KB, the NEWEST records never reached stdout and klug
    # exited 0. Twelve records (156 B) through a 96-byte buffer must all arrive, in order.
    _rd_reset(); _rd_twelve();
    assert_eq(_drain(KLUG_LVL_ALL), 0, "a log bigger than the buffer -> 0");
    assert_eq(_sink_is(&_rd_all), 1, "every record reached stdout, in order — the newest included");
    assert_eq(_rd_calls, 13, "twelve records + the -EAGAIN that ends the log");
    assert_eq(_wr_calls, 3, "three batches (5 + 5 + 2 records) -> three writes");
    assert_eq(_rd_bad_fd, 0, "every read went to the fd the drain was handed");
    return 0;
}

fn test_drain_never_offers_less_than_a_record() {
    # A read offered less than the next record loses it (devkmsg_read: -EINVAL, AFTER advancing past
    # it). So every offer is >= KLUG_KMSG_REC_MAX, and a record of exactly that size still lands at
    # the tightest point: four 16-byte records leave 32 of 96 bytes, and the 32-byte record fits.
    _rd_reset(); _rd_twelve();
    _drain(KLUG_LVL_ALL);
    assert(_rd_min_offer >= 32, "no read was offered less than a worst-case record");
    _rd_reset();
    _rd_push("6,1,10,-;abcdef\n"); _rd_push("6,1,10,-;bcdefg\n");
    _rd_push("6,1,10,-;cdefgh\n"); _rd_push("6,1,10,-;defghi\n");
    _rd_push("6,1,10,-;abcdefghijklmnopqrstuv\n");
    assert_eq(_drain(KLUG_LVL_ALL), 0, "a worst-case record at the tightest offer -> 0");
    assert_eq(_sink_is(&_rd_all), 1, "... and it was delivered whole");
    assert(_rd_min_offer >= 32, "... from an offer of at least a worst-case record");
    return 0;
}

fn test_drain_filters_across_batches() {
    # The lens runs per batch, and a batch ends on a record boundary (one read = one record + its
    # continuation lines), so an err record keeps its dictionary line and batches change nothing
    # about WHICH bytes are selected — only how many writes carry them.
    _rd_reset();
    _rd_push("6,1,10,-;a01\n"); _rd_push("6,1,10,-;a02\n"); _rd_push("6,1,10,-;a03\n");
    _rd_push("3,1,10,-;e04\n SUBSYSTEM=x\n");          # one read: the record and its continuation
    _rd_push("6,1,10,-;a05\n"); _rd_push("6,1,10,-;a06\n");
    _rd_push("4,1,10,-;w07\n"); _rd_push("3,1,10,-;e08\n");
    assert_eq(_drain(KLUG_LVL_ERR), 0, "-e across batches -> 0");
    assert_eq(_sink_is("3,1,10,-;e04\n SUBSYSTEM=x\n3,1,10,-;e08\n"), 1, "-e: both errs, the continuation kept");
    assert_eq(_wr_calls, 2, "-e: one run per batch -> two writes");
    _rd_reset();
    _rd_push("6,1,10,-;a01\n"); _rd_push("6,1,10,-;a02\n"); _rd_push("6,1,10,-;a03\n");
    _rd_push("3,1,10,-;e04\n SUBSYSTEM=x\n");
    _rd_push("6,1,10,-;a05\n"); _rd_push("6,1,10,-;a06\n");
    _rd_push("4,1,10,-;w07\n"); _rd_push("3,1,10,-;e08\n");
    assert_eq(_drain(KLUG_LVL_WARN), 0, "-w across batches -> 0");
    assert_eq(_sink_is("3,1,10,-;e04\n SUBSYSTEM=x\n4,1,10,-;w07\n3,1,10,-;e08\n"), 1,
      "-w: the err + continuation, then the adjacent warning and err");
    assert_eq(_wr_calls, 2, "-w: adjacent records in the second batch coalesce -> two writes");
    return 0;
}

fn test_drain_eagain_and_zero_end_the_log() {
    _rd_reset(); _rd_push("6,1,10,-;a01\n"); _rd_push("6,1,10,-;a02\n");
    assert_eq(_drain(KLUG_LVL_ALL), 0, "-EAGAIN after two records -> 0");
    assert_eq(_sink_is(&_rd_all), 1, "-EAGAIN: both records delivered");
    assert_eq(_rd_calls, 3, "-EAGAIN: no read after it");
    _rd_reset(); _rd_push("6,1,10,-;a01\n"); _rd_push(0); _rd_push("6,1,10,-;a02\n");
    assert_eq(_drain(KLUG_LVL_ALL), 0, "0 (EOF) -> 0");
    assert_eq(_sink_is("6,1,10,-;a01\n"), 1, "0 ends the log: nothing after it is read");
    assert_eq(_rd_calls, 2, "0: no read after it");
    _rd_reset();
    assert_eq(_drain(KLUG_LVL_ALL), 0, "an empty log -> 0");
    assert_eq(_wr_calls, 0, "an empty log writes nothing");
    return 0;
}

fn test_drain_epipe_is_a_gap_not_the_end() {
    # -EPIPE: the kernel overwrote records this reader had not reached. Through 0.2.0 it ENDED the
    # dump there, silently, exit 0. Now the drain carries on from the oldest survivor (as dmesg does)
    # and says on stderr that the dump has a gap (printed during this test, not captured); the exit
    # stays 0 because the log lost those records, not klug.
    _rd_reset();
    _rd_push("6,1,10,-;a01\n"); _rd_push(KLUG_EPIPE); _rd_push("6,1,10,-;a02\n");
    _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push("6,1,10,-;a03\n");
    assert_eq(_drain(KLUG_LVL_ALL), 0, "-EPIPE -> 0, and the drain goes on");
    assert_eq(_sink_is(&_rd_all), 1, "-EPIPE: every record after the gap delivered");
    assert_eq(_rd_calls, 7, "-EPIPE: one re-read per -EPIPE");
    return 0;
}

fn test_drain_eintr_retries() {
    _rd_reset();
    _rd_push(KLUG_EINTR); _rd_push("6,1,10,-;a01\n"); _rd_push(KLUG_EINTR); _rd_push("6,1,10,-;a02\n");
    assert_eq(_drain(KLUG_LVL_ALL), 0, "-EINTR -> 0");
    assert_eq(_sink_is(&_rd_all), 1, "-EINTR: the retry reads into the same offset");
    assert_eq(_rd_calls, 5, "-EINTR: one retry each");
    return 0;
}

fn test_drain_read_failure_emits_what_was_read_and_fails() {
    # Any other errno is a real failure (-EIO here). The records before it are real, so they are
    # still dumped — across a batch flush — but the exit code says the dump is INCOMPLETE.
    _rd_reset();
    _rd_push("6,1,10,-;a01\n"); _rd_push("6,1,10,-;a02\n"); _rd_push("6,1,10,-;a03\n");
    _rd_push("6,1,10,-;a04\n"); _rd_push("6,1,10,-;a05\n"); _rd_push("6,1,10,-;a06\n");
    _rd_push(0 - 5);
    _rd_push("6,1,10,-;a07\n");
    assert_eq(_drain(KLUG_LVL_ALL), 1, "-EIO -> 1");
    assert_eq(_sink_is_first(78), 1, "-EIO: the six records before it delivered, nothing after");
    assert_eq(_rd_calls, 7, "-EIO: no read after it");
    assert_eq(_wr_calls, 2, "-EIO: the batch flushed before it and the partial batch");
    return 0;
}

fn test_drain_retries_are_bounded() {
    # A reader that never yields a record (-EPIPE or -EINTR forever) must not spin klug forever.
    # Same bound and shape as the agnos write stall: the retry that finds KLUG_STALL_MAX consecutive
    # misses fails, so MAX + 1 reads are made — and a record in between resets the count.
    var saved = KLUG_STALL_MAX;
    KLUG_STALL_MAX = 5;
    _rd_reset(); _rd_always(KLUG_EPIPE);
    assert_eq(_drain(KLUG_LVL_ALL), 1, "-EPIPE forever -> 1");
    assert_eq(_rd_calls, 6, "-EPIPE forever: exactly KLUG_STALL_MAX + 1 reads");
    _rd_reset(); _rd_always(KLUG_EINTR);
    assert_eq(_drain(KLUG_LVL_ALL), 1, "-EINTR forever -> 1");
    assert_eq(_rd_calls, 6, "-EINTR forever: exactly KLUG_STALL_MAX + 1 reads");
    _rd_reset();
    _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE);
    _rd_push("6,1,10,-;a01\n");
    _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE);
    _rd_push("6,1,10,-;a02\n");
    assert_eq(_drain(KLUG_LVL_ALL), 0, "5 misses, a record, 5 misses, a record -> 0");
    assert_eq(_sink_is(&_rd_all), 1, "a record resets the bound: both delivered");
    _rd_reset();
    _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE);
    _rd_push("6,1,10,-;a01\n");
    _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE); _rd_push(KLUG_EPIPE);
    _rd_push(KLUG_EPIPE);
    assert_eq(_drain(KLUG_LVL_ALL), 1, "a sixth consecutive miss trips the bound");
    assert_eq(_rd_calls, 12, "tripped on the 6th miss after the record");
    assert_eq(_sink_is("6,1,10,-;a01\n"), 1, "what was read before the bound is still delivered");
    KLUG_STALL_MAX = saved;
    return 0;
}

fn test_drain_write_failure_stops_reading() {
    # A write failure at a batch flush ends the drain AT ONCE — no further reads, exit 1. Reading on
    # and writing a later batch would put a hole in the middle of the dump (the 0.1.5 shape).
    _rd_reset(); _rd_twelve();
    _wr_push(0 - 32);                                   # -EPIPE on the first flush
    assert_eq(_drain(KLUG_LVL_ALL), 1, "write failure mid-drain -> 1");
    assert_eq(_rd_calls, 5, "write failure: the five records of batch one, and no read after the flush");
    assert_eq(_wr_calls, 1, "write failure: no later batch is written");
    assert_eq(_wr_sunk, 0, "write failure: nothing reached stdout");
    return 0;
}

fn test_drain_production_constants() {
    assert_eq(KLUG_KMSG_REC_MAX, 8192, "a /dev/kmsg record is at most CONSOLE_EXT_LOG_MAX = 8192 B");
    assert(KLUG_RING_BYTES >= KLUG_KMSG_REC_MAX * 4, "the 64 KB buffer holds several worst-case records");
    assert_eq(KLUG_EAGAIN, 0 - 11, "EAGAIN is -11");
    assert_eq(KLUG_EPIPE, 0 - 32, "EPIPE is -32");
    return 0;
}

fn test_emit_lines_counts_tags_and_reports_failure() {
    # klug_emit_lines is klug_emit without the verdict: it returns the tagged-line count (summed by
    # the drain across batches) or -1 on a write failure; klug_emit_done turns that into the exit code.
    _wr_reset(0); _wr_strict = 0;
    var log = "[W] a\nplain\n[E] b\n[I] c\n";
    assert_eq(klug_emit_lines(KLUG_LVL_WARN, log, strlen(log), KLUG_SRC_RING, &_fake_writer, KLUG_WR_LINUX), 3,
      "-w: three tagged lines counted ([W], [E], [I])");
    _wr_reset(0); _wr_strict = 0;
    assert_eq(klug_emit_lines(KLUG_LVL_ALL, log, strlen(log), KLUG_SRC_RING, &_fake_writer, KLUG_WR_LINUX), 0,
      "bare dump: the fast path does not count");
    _wr_reset(0); _wr_strict = 0; _wr_push(0 - 32);
    assert_eq(klug_emit_lines(KLUG_LVL_WARN, log, strlen(log), KLUG_SRC_RING, &_fake_writer, KLUG_WR_LINUX), 0 - 1,
      "write failure -> -1");
    assert_eq(klug_emit_done(KLUG_LVL_WARN, 0 - 1, 10), 1, "verdict: a write failure exits 1");
    assert_eq(klug_emit_done(KLUG_LVL_WARN, 3, 10), 0, "verdict: tags seen exits 0");
    assert_eq(klug_emit_done(KLUG_LVL_ALL, 0, 10), 0, "verdict: a bare dump exits 0");
    assert_eq(klug_emit_done(KLUG_LVL_WARN, 0, 0), 0, "verdict: an empty log exits 0");
    return 0;
}

fn main(): i64 {
    test_group("klug severity lens — recognized prefixes");
    test_recognized_prefixes();
    test_group("klug severity lens — unprefixed / malformed");
    test_unprefixed_lines_always_show();
    test_group("klug tag presence vs level");
    test_tag_presence_is_distinct_from_level();
    test_tag_recognizes_all_three_levels();
    test_group("klug lens sees through the agnos uptime prefix");
    test_lens_sees_through_the_uptime_prefix();
    test_unprefixed_lines_still_work();
    test_time_prefix_needs_all_four_anchors();
    test_group("klug severity ordering");
    test_severity_ordering();
    test_group("klug ring-size contract");
    test_ring_size_matches_kernel();
    test_group("klug /dev/kmsg lens — priority -> level");
    test_kmsg_priority_maps_to_level();
    test_kmsg_facility_bits_are_ignored();
    test_group("klug /dev/kmsg lens — not a record");
    test_kmsg_not_a_record_is_untagged();
    test_group("klug /dev/kmsg lens — continuation lines");
    test_kmsg_continuation_lines_inherit_their_record();
    test_group("klug lens is per-source, not per-byte");
    test_lens_is_per_source_not_per_byte();
    test_group("klug write loop — short writes");
    test_write_loop_loops_over_short_writes();
    test_write_loop_full_write_is_one_call();
    test_write_loop_zero_length_never_writes();
    test_group("klug write loop — Linux zero-return policy");
    test_write_loop_linux_eintr_retries();
    test_write_loop_linux_zero_is_fatal();
    test_write_loop_linux_other_errno_is_fatal();
    test_group("klug write loop — agnos backpressure policy");
    test_write_loop_agnos_zero_is_backpressure();
    test_write_loop_agnos_negative_is_fatal();
    test_write_loop_agnos_stall_is_bounded();
    test_write_loop_agnos_stall_resets_on_progress();
    test_write_loop_production_constants();
    test_group("klug emit — the filter over a whole log");
    test_emit_unfiltered_is_one_write_of_everything();
    test_emit_kmsg_err_keeps_a_record_with_its_continuations();
    test_emit_kmsg_warn_coalesces_adjacent_passing_lines();
    test_emit_ring_warn_is_the_agnos_lens();
    test_emit_trailing_partial_line_is_filtered_too();
    test_emit_nothing_selected_is_still_exit_zero();
    test_emit_write_failure_stops_and_reports_one();
    test_emit_lines_counts_tags_and_reports_failure();
    test_group("klug /dev/kmsg drain — the whole log, batch by batch");
    test_drain_dumps_a_log_bigger_than_the_buffer();
    test_drain_never_offers_less_than_a_record();
    test_drain_filters_across_batches();
    test_group("klug /dev/kmsg drain — end of log, gaps, retries, failures");
    test_drain_eagain_and_zero_end_the_log();
    test_drain_epipe_is_a_gap_not_the_end();
    test_drain_eintr_retries();
    test_drain_read_failure_emits_what_was_read_and_fails();
    test_drain_retries_are_bounded();
    test_drain_write_failure_stops_reading();
    test_drain_production_constants();
    return assert_summary();
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
