# klug.cyr — the klug reader: kernel-log dump + optional severity lens.
#
# klug is the *Kernel Logs Unified Grep* subsystem. The kernel half (the agnos
# kernel's `core/klug.cyr`) unifies every line of kernel output into one 64 KB
# ring buffer; this is the userland half — a sovereign `dmesg` that copies that
# ring to stdout. Filtering past the severity lens stays the shell's job:
# `klug | grep panic`. The kernel UNIFIES, GREP stays userland.
#
# Pure helpers + the dump routine live here (no top-level execution) so the test
# harness can include the module. `src/main.cyr` is the entry. The libs this
# module uses (syscalls / io / string) are included by main.cyr and the harness
# before this file, per the project-include convention.

# main.cyr declares `var klug_buf[KLUG_RING_WORDS]`, so this enum IS the buffer's
# extent. A `var X[N]` is N×u64, so the buffer size and the byte count below can no
# longer drift apart silently — and the harness (which includes this file but not
# main.cyr, and so cannot see klug_buf at all) can cross-check the two.
enum KlugRing { KLUG_RING_WORDS = 8192; }   # ×u64 = 65536 B

# The agnos klug ring is 64 KB. `klug`#36 fills up to this many bytes (oldest→
# newest; a smaller buffer would get the newest-N tail, but we always pass the
# full ring size so one read drains it all). Kept as an independent literal on
# purpose: the cross-check in tests/klug.tcyr only has teeth while this and
# KLUG_RING_WORDS are stated separately.
var KLUG_RING_BYTES = 65536;

# Minimum-severity filter, ascending.
var KLUG_LVL_ALL  = 0;   # show everything (default)
var KLUG_LVL_WARN = 1;   # warnings + errors
var KLUG_LVL_ERR  = 2;   # errors only

# Which log the lens is reading. The two sources tag severity differently, so the lens is
# TOLD which one it is looking at rather than guessing from the bytes — guessing would let a
# ring-3 program's "3,foo" CSV line on agnos score as an alert. klug_dump picks the source
# once, at build time; the tests pass both explicitly, which is what makes the agnos rule
# ("a leading digit is just a byte") provable on the host.
var KLUG_SRC_RING = 0;   # agnos klug#36 ring: "[I] "/"[W] "/"[E] " tags behind an optional uptime prefix
var KLUG_SRC_KMSG = 1;   # Linux /dev/kmsg wire records: "<pri>,<seq>,<ts>,<flags>;<msg>" + " KEY=VAL" continuations

# The kernel's klug_info/klug_warn/klug_err prefix lines with "[I] " / "[W] " /
# "[E] " (see core/klug.cyr). Return the severity of a line beginning at `p`
# (length `len`): 2=err, 1=warn, 0=info/plain. Lines without a recognized prefix
# (boot lines, raw kprintln output) are level 0, exactly like "[I] ": they appear
# in the default dump, but -w/-e DROP them, because the gate is level >= min_level.
# That holds on agnos too — a raw kprintln panic banner carries no prefix, so hunt
# one with `klug | grep -i panic`, not `klug -e`.
# The agnos kernel prefixes every KERNEL-ORIGIN line with a fixed-width 15-byte uptime field —
# "[    4.123456] ", built by klog_build_prefix in kernel/core/kprint.cyr (agnos 1.56.58). Return 15
# if `p` starts with one, else 0.
#
# ⛔ THIS EXISTS BECAUSE THE LENS IS OFFSET-FIXED AND THE PREFIX WOULD HAVE DISARMED IT SILENTLY.
# klug_level_of tests byte 0 for [ and byte 2 for ]. Under a prefix, byte 0 is still [ so the first
# guard passes, but byte 2 is a space — so EVERY line scored level 0, `klug -w` printed nothing and
# exited 0, and that is indistinguishable from "no warnings" — a pure silent false negative, on the
# one command an operator reaches for when something has gone wrong.
#
# ⚠ FOUR ANCHORS, NOT ONE. Byte 0 alone is not enough: a legitimate "[E] disk error" also starts with
# [. Requiring the . at 6, the ] at 13 and the space at 14 pins the whole fixed-width shape, and no
# level line can satisfy it (in "[E] dis" byte 6 is `s`). Cheap enough to run per line: four loads.
#
# ⚠ RING-3 OUTPUT NEVER CARRIES THIS PREFIX and must not be made to look as if it does — the kernel
# raises klog_raw_depth around serial_dev_write so userland bytes pass through undecorated. A ring-3
# line that happens to start with [ simply fails one of the four anchors and is treated as untagged,
# which is correct: it has no severity.
fn klug_time_prefix_len(p, len): i64 {
    if (len < 15) { return 0; }
    if (load8(p) != 91)       { return 0; }     # 91 = [
    if (load8(p + 6) != 46)   { return 0; }     # 46 = .
    if (load8(p + 13) != 93)  { return 0; }     # 93 = ]
    if (load8(p + 14) != 32)  { return 0; }     # 32 = space
    return 15;
}

# The /dev/kmsg lens primitive. A record is "<pri>,<seq>,<ts>,<flags>[,..];<msg>\n"
# (Documentation/ABI/testing/dev-kmsg) and <pri> is the syslog value facility<<3 | level, so
# `pri & 7` is the level: 0 emerg · 1 alert · 2 crit · 3 err · 4 warning · 5 notice · 6 info ·
# 7 debug. Sliced onto the three-step lens the way `dmesg --level` would: level <= 3 -> ERR,
# 4 -> WARN, everything else -> ALL. Facility bits are ignored on purpose — a userspace
# writer's "12," (user.warning) is still a warning.
# Returns -1 when the bytes at `p` are NOT a record header (no leading decimal run, or one not
# followed by a comma), so a caller can tell "notice" (ALL) from "not a record" (also ALL, but
# klug_has_level_tag must not count it and klug_line_level must look at the record before it).
# The decimal run is capped at 10 digits: a longer one is not a priority and is refused as
# not-a-record rather than wrapped into one.
fn klug_kmsg_pri_level(p, len): i64 {
    var n = 0;                                         # digits consumed
    var pri = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (n >= len) { scanning = 0; }
        else {
            var c = load8(p + n);
            if (c < 48) { scanning = 0; }              # below '0' (48)
            else {
                if (c > 57) { scanning = 0; }          # above '9' (57)
                else {
                    if (n >= 10) { return 0 - 1; }     # an 11th DIGIT: not a priority (the 11th byte may be the comma)
                    pri = pri * 10 + (c - 48);
                    n = n + 1;
                }
            }
        }
    }
    if (n == 0) { return 0 - 1; }                      # no digits at all
    if (n >= len) { return 0 - 1; }                    # digits to the end: no comma
    if (load8(p + n) != 44) { return 0 - 1; }          # ',' = 44
    var level = pri & 7;
    if (level <= 3) { return KLUG_LVL_ERR; }
    if (level == 4) { return KLUG_LVL_WARN; }
    return KLUG_LVL_ALL;
}

# Severity of the line at `p` (length `len`) as read from `src`: KLUG_LVL_ERR / _WARN / _ALL.
#   KLUG_SRC_RING — the agnos tag lens: "[E] " -> ERR, "[W] " -> WARN, "[I] " and anything else
#                   (boot lines, raw kprintln, ring-3 output) -> ALL, after stepping over the
#                   1.56.58 uptime prefix. klug_time_prefix_len above says why the anchors are
#                   what they are.
#   KLUG_SRC_KMSG — the /dev/kmsg lens: the record's syslog priority decides (klug_kmsg_pri_level).
#                   A line that is not a record header — a " KEY=VAL" continuation, or garbage —
#                   is ALL here; klug_line_level is what hands a continuation its record's level.
# Stateless and per-line on purpose: klug_dump feeds it one line at a time.
fn klug_level_of(p, len, src): i64 {
    if (src == KLUG_SRC_KMSG) {
        var k = klug_kmsg_pri_level(p, len);
        if (k >= 0) { return k; }
        return KLUG_LVL_ALL;
    }
    var toff = klug_time_prefix_len(p, len);           # step over "[    4.123456] " if present
    var q = p + toff;
    var qlen = len - toff;
    if (qlen < 4) { return KLUG_LVL_ALL; }
    if (load8(q) != 91) { return KLUG_LVL_ALL; }       # '[' = 91
    if (load8(q + 2) != 93) { return KLUG_LVL_ALL; }   # ']' = 93
    var c = load8(q + 1);
    if (c == 69) { return KLUG_LVL_ERR; }              # 'E' = 69
    if (c == 87) { return KLUG_LVL_WARN; }             # 'W' = 87
    return KLUG_LVL_ALL;                               # 'I' or anything else
}

# Does this line carry a RECOGNIZED level tag at all? Distinct from klug_level_of,
# which cannot answer it: that fn returns KLUG_LVL_ALL (0) both for a real "[I] "
# and for a line with no tag whatsoever, because both must appear in a bare dump.
#
# ⛔⛔ WHY THIS EXISTS — `-w`/`-e` COULD REPORT "NO WARNINGS" ON A KERNEL THAT HAS NO
# LENS AT ALL, AND THAT IS THE STATE AGNOS SHIPS IN TODAY. The kernel's klug_info/
# klug_warn/klug_err have exactly THREE call sites and all three sit inside
# `#ifdef EXEC_SELFTEST` (agnos kernel/core/main.cyr `exec_disk_selftest`; lines 3072-3074,
# guarded 2924-3370, as of agnos 1.57.12), which is off in every production build. So a
# real boot log contains ZERO tagged lines, every line scores level 0, `klug -w` prints
# nothing and exits 0 — and "this box logged no warnings" is indistinguishable from
# "this filter is a no-op".
# A tool that cannot tell those apart is worse than one without the flag.
#
# ⚠ AND IT IS ABOUT TO MATTER MORE, NOT LESS. The lens is a FIXED-OFFSET test — '['
# at byte 0, ']' at byte 2 — so ANY field prepended to the line disarms it silently.
# A Linux-style "[    4.123456] " uptime prefix is the live proposal for the agnos
# kernel log; the day it lands, every line here scores 0. This counter is what turns
# that from a silent false negative into a message on stderr.
# On the /dev/kmsg source a record header IS the tag — a "6," info record counts exactly as
# a "[I] " line does on the ring: level 0, but present, so a filter that drops everything is
# reported as "no warnings" and not as "no lens".
fn klug_has_level_tag(p, len, src): i64 {
    if (src == KLUG_SRC_KMSG) {
        if (klug_kmsg_pri_level(p, len) >= 0) { return 1; }
        return 0;
    }
    var toff = klug_time_prefix_len(p, len);           # step over "[    4.123456] " if present
    var q = p + toff;
    var qlen = len - toff;
    if (qlen < 4) { return 0; }
    if (load8(q) != 91) { return 0; }                  # '[' = 91
    if (load8(q + 2) != 93) { return 0; }              # ']' = 93
    var c = load8(q + 1);
    if (c == 69) { return 1; }                         # 'E'
    if (c == 87) { return 1; }                         # 'W'
    if (c == 73) { return 1; }                         # 'I'
    return 0;
}

# The per-line level the dump actually filters on. klug_level_of, except that on the /dev/kmsg
# source a line beginning with a space is a CONTINUATION of the record before it — the
# " SUBSYSTEM=usb" / " DEVICE=+usb:1-2" dictionary lines the kernel appends to dev_printk
# records — and carries no priority of its own. It inherits `prev`, the level of the last
# header, so `klug -e` keeps an error's context lines with the error instead of dropping them
# as level-0 noise. On the ring source a leading space is just a byte and `prev` is never
# consulted: a ring-3 program indenting its output is not continuing the kernel line above it.
fn klug_line_level(p, len, src, prev): i64 {
    if (src == KLUG_SRC_KMSG) {
        if (len > 0) {
            if (load8(p) == 32) { return prev; }       # ' ' = 32
        }
    }
    return klug_level_of(p, len, src);
}

# `-h`/`--help`: usage on stdout, exit 0. The agnos build appends the redirect warning
# (see the comment inside); the Linux build appends how the lens reads /dev/kmsg.
fn klug_usage(): i64 {
    println("klug — dump the AGNOS kernel log (the klug unified ring buffer).");
    println("");
    println("usage: klug [-w|--warn] [-e|--err] [-h|--help]");
    println("  (no flags)   dump the whole kernel log");
    println("  -w, --warn   only warnings and errors ([W]/[E])");
    println("  -e, --err    only errors ([E])");
    println("  -h, --help   this help");
    println("");
    println("filter further with the shell: klug | grep <pattern>");
    # ⚠ AGNOS ONLY — reading the log CONSUMES it, unless you redirect. fd 1 is a
    # VFS_DEVICE, so klug's own write(1,…) lands in vfs_write's device arm →
    # dev_write → serial_dev_write (core/devs.cyr) → kprint → klug_append: every
    # console-bound ring-3 byte is appended to the very ring klug#36 just read.
    # The dump is up to KLUG_RING_BYTES and the ring is exactly KLUG_RING_BYTES,
    # so a console dump re-appends the whole log to itself; while the ring is
    # still short of full (a ~20 KB boot log) that DOUBLES it, and the second
    # dump wraps and takes the boot head with it. Redirecting is not a nicety —
    # it is how the log survives being read. A pipe is safe for the same reason
    # the redirect is: a pipe fd takes vfs_write's VFS_PIPE arm, never kprint, so
    # only grep's matched lines are console-bound.
    # ⛔ Do NOT drop this note if a kernel-side fix ever lands — suppressing the
    # tap for klug#36's own output fixes THIS tool, not the property (any large
    # console dump still ages the ring), and klug is staged onto older kernels
    # by agnos/scripts/burn/stage-tools.sh.
    # agnos-side: docs/development/state.md records the mechanism as unfixed BY
    # DECISION (1.56.48), and core/syscall.cyr `fault_kill_current` carries the
    # same `run /bin/klug > /f.txt` note.
    #ifdef CYRIUS_TARGET_AGNOS
    println("");
    println("on AGNOS, redirect instead of dumping to the console:");
    println("      run /bin/klug > /f.txt");
    println("  the console write path feeds the klug ring, so dumping the log to");
    println("  the console re-appends the dump to the log and ages the oldest boot");
    println("  lines out. Piping is safe: klug | grep writes into the pipe, and");
    println("  only the matched lines reach the console.");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    println("");
    println("on Linux the log is /dev/kmsg (needs root, or kernel.dmesg_restrict=0), dumped");
    println("  as its raw records; the lens reads each record's syslog level:");
    println("  -w = warning and worse (level <= 4), -e = err and worse (level <= 3).");
    #endif
    return 0;
}

# -EINTR. klug installs no signal handlers, so this is belt-and-braces.
var KLUG_EINTR = 0 - 4;
# -EAGAIN / -EPIPE as a /dev/kmsg read returns them (Linux values; the drain is Linux-only).
var KLUG_EAGAIN = 0 - 11;
var KLUG_EPIPE = 0 - 32;
# Bound on consecutive no-progress retries before we give up: agnos write yields (the consumer
# is gone) and /dev/kmsg -EINTR / -EPIPE re-reads (the reader never yields a record).
var KLUG_STALL_MAX = 100000;

# The largest record a /dev/kmsg read hands out: the kernel's CONSOLE_EXT_LOG_MAX, the size of
# devkmsg_read's output buffer (longer records are truncated to it). ⛔ NOT AN OPTIMISATION: a
# read offered fewer bytes than the next record fails -EINVAL, and devkmsg_read advances the
# reader past that record BEFORE its size check — the record is lost, not held back. The drain
# offers at least this much on every read so that can never happen.
var KLUG_KMSG_REC_MAX = 8192;

# Zero-return policy for the write loop — what a write that accepted NOTHING means. Chosen
# per target in klug_dump and passed to the loop as a VALUE, so both arms are compiled,
# and unit-tested, on the host. Until 0.2.0 the agnos arm sat behind #ifdef and had never
# executed anywhere but on iron, which is the one place a bug in it is expensive to find.
var KLUG_WR_LINUX = 0;   # 0 is pathological (fail); -EINTR retries; any other negative is fatal
var KLUG_WR_AGNOS = 1;   # 0 is pipe backpressure (yield + retry, bounded by KLUG_STALL_MAX); any negative is fatal

# The production writer: fd 1, one raw write, no looping — looping is klug_write_loop's job.
# Shaped `(p, len) -> count-or-negative-errno` so a test can stand a scripted fake in its place.
fn klug_stdout_write(p, len): i64 {
    return syscall(SYS_WRITE, 1, p, len);
}

# The production reader: one raw read of `fd` — on /dev/kmsg, exactly one record. Shaped
# `(fd, p, len) -> count-or-negative-errno` so a test can stand a scripted fake in its place.
fn klug_fd_read(fd, p, len): i64 {
    return syscall(SYS_READ, fd, p, len);
}

# Write EXACTLY `len` bytes from `p` through `writer` (a `&fn(p, len)` returning the count
# accepted, or a negative errno), looping over short writes under `mode`'s zero-return policy.
# Returns 0 when all `len` bytes were accepted, 1 otherwise. klug_emit is the only caller;
# klug_dump hands it fd 1 (klug_stdout_write) with this target's policy.
#
# WHY THIS EXISTS: a single write(1, buf, 65536) is not a promise of 65536 bytes.
#   · agnos `pipe_write` (kernel/core/vfs.cyr) refuses past PIPE_RING = 4080 and
#     returns a SHORT count on purpose — "a short return is the contract". So
#     `klug | grep panic`, the command klug's own help text calls safe, delivered
#     at most 4080 bytes of a 20–64 KB log until this loop existed.
#   · agnos `ext2_write_at` returns a PARTIAL count on ENOSPC, so `run /bin/klug >
#     /f.txt` on a full disk silently kept only the head. Linux does the same.
#   · The console arm is NOT affected: `serial_dev_write` (core/devs.cyr) chunks
#     internally and returns the full count — it was rewritten because of this very
#     bug, which the kernel worked around on that one arm and no other.
# A 0 return means DIFFERENT THINGS on the two targets and must not be merged: on
# agnos it is backpressure from a ring whose consumer has not been scheduled yet
# (retry after a yield), on Linux it is pathological (fail).
fn klug_write_loop(writer, mode, p, len): i64 {
    var w = 0;
    var stall = 0;
    while (w < len) {
        var r = fncall2(writer, p + w, len - w);
        if (r > 0) { w = w + r; stall = 0; }
        else {
            if (mode == KLUG_WR_AGNOS) {
                # -1 is a real error (bad fd / write end closed) — stop, do not spin.
                if (r < 0) { return 1; }
                # r == 0: pipe ring full. Yield so the consumer runs, and bound the
                # stall so a vanished consumer (`klug | head`) cannot hang klug forever
                # — agnos pipe_write gives the writer no reader-gone signal.
                if (stall >= KLUG_STALL_MAX) { return 1; }
                stall = stall + 1;
                sys_sched_yield();
            } else {
                if (r == 0) { return 1; }
                if (r != KLUG_EINTR) { return 1; }   # -EINTR retries; anything else is fatal
            }
        }
    }
    return 0;
}

# Diagnostics go to fd 2: fd 1 carries the dump, so error prose on stdout lands
# inside `klug > f.txt` and gets piped into `klug | grep`. On agnos a failed
# fd-1 write is precisely the case where fd 1 cannot take more bytes anyway.
fn klug_err_line(s: cstring): i64 {
    syscall(SYS_WRITE, 2, s, strlen(s));
    syscall(SYS_WRITE, 2, "\n", 1);
    return 0;
}

# Read the kernel log into `buf` (KLUG_RING_BYTES bytes) and write the lines at or
# above `min_level` to stdout. Returns 0 on success, 1 on a read failure or an
# incomplete write. This is the I/O half: it opens the log this target has and hands
# it to code that runs under the test harness — klug_emit (agnos: the whole ring is
# one read) or klug_kmsg_drain (Linux: /dev/kmsg, batch by batch) — with this
# target's lens source (see KLUG_SRC_*) and write policy (see KLUG_WR_*).
fn klug_dump(min_level, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Native: klug#36 copies the klug ring into buf and returns bytes written. It
    # only ever copies klug_buf, never other kernel memory, so it can't leak. The
    # ring is exactly KLUG_RING_BYTES, so one read is the whole log.
    var n = sys_klug(buf, KLUG_RING_BYTES);
    if (n < 0) { klug_err_line("klug: kernel log read failed"); return 1; }
    return klug_emit(min_level, buf, n, KLUG_SRC_RING, &klug_stdout_write, KLUG_WR_AGNOS);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # Dev-host dogfooding: the klug ring is agnos-only, so dump the Linux kernel
    # ring via /dev/kmsg. The node is mode 0644, but `kernel.dmesg_restrict=1` (the
    # default on systemd distros) makes open() return EPERM for non-root anyway, so
    # an unprivileged run normally lands in the branch below — that is the host
    # policy, not a klug failure. O_NONBLOCK so a read returns -EAGAIN once the log
    # is drained instead of blocking for future messages.
    var fd = sys_open("/dev/kmsg", O_RDONLY | O_NONBLOCK, 0);
    if (fd < 0) {
        klug_err_line("klug: kernel log unavailable on this host (open /dev/kmsg failed);");
        klug_err_line("      needs root, or kernel.dmesg_restrict=0.");
        klug_err_line("      the native reader is agnos klug#36 — build with `cyrius build --agnos`.");
        return 1;
    }
    var rc = klug_kmsg_drain(&klug_fd_read, fd, buf, KLUG_RING_BYTES, min_level, &klug_stdout_write, KLUG_WR_LINUX);
    syscall(SYS_CLOSE, fd);
    return rc;
    #endif
}

# Drain /dev/kmsg — open as `fd`, O_NONBLOCK — through `reader` (a `&fn(fd, p, len)`
# returning the bytes read or a negative errno; klug_dump hands it klug_fd_read) into
# `buf` (`cap` bytes), emitting it batch by batch through klug_emit_lines. Returns 0
# when the whole log was dumped, 1 when a read or a write failed (what was read before
# a read failure is still emitted, and said on stderr to be incomplete).
#
# ⛔ WHY IT STREAMS. Through 0.2.0 the Linux arm read until the 64 KB buffer was full
# and stopped. A fresh /dev/kmsg open starts at the OLDEST record, so on any host whose
# log is over 64 KB — the x86 default ring is 128 KB, and a box that has been up a
# while keeps it full — klug dumped the oldest 64 KB, silently dropped the NEWEST
# records (the ones an operator reaches for) and exited 0. Now a batch is emitted
# whenever the buffer cannot take another worst-case record, the buffer is reused, and
# the dump is the whole log at any size.
#
# Every read is offered at least KLUG_KMSG_REC_MAX bytes (see there: that is what keeps
# a record from being dropped). One read returns exactly one record WITH its " KEY=VAL"
# continuation lines, so a batch always ends on a record boundary and the continuation
# state inside klug_emit_lines never has to cross one.
#
# What a read returns, as devkmsg_read hands it out:
#   > 0      a record — keep reading.
#   -EAGAIN  caught up (O_NONBLOCK): the end of the log. So is 0, which /dev/kmsg never returns.
#   -EPIPE   the kernel overwrote records this reader had not reached and moved it on to the
#            oldest survivor: the dump has a GAP there. Carry on (dmesg does), and say so on
#            stderr, because a gap nobody mentions reads as a complete log.
#   -EINTR   retry (belt-and-braces; klug installs no handlers).
#   other    a real failure: stop, emit what was read, exit 1.
# -EPIPE / -EINTR retries are bounded by KLUG_STALL_MAX consecutive non-records, so a
# reader that never yields one cannot spin klug forever.
fn klug_kmsg_drain(reader, fd, buf, cap, min_level, writer, mode): i64 {
    var off = 0;                                        # bytes in the current batch
    var total = 0;                                      # bytes read, every batch
    var tagged = 0;                                     # severity-tagged lines, every batch
    var gap = 0;                                        # an -EPIPE was seen
    var failed = 0;                                     # a read failed for real
    var stall = 0;                                      # consecutive retries without a record
    var t = 0;
    var draining = 1;
    while (draining == 1) {
        if (cap - off < KLUG_KMSG_REC_MAX) {            # no room for a worst-case record: flush
            t = klug_emit_lines(min_level, buf, off, KLUG_SRC_KMSG, writer, mode);
            if (t < 0) { return klug_emit_done(min_level, t, total); }   # stop: never read past a hole
            tagged = tagged + t;
            off = 0;
        }
        var m = fncall3(reader, fd, buf + off, cap - off);
        if (m > 0) { off = off + m; total = total + m; stall = 0; }
        else {
            var retry = 0;
            if (m == KLUG_EPIPE) { gap = 1; retry = 1; }
            if (m == KLUG_EINTR) { retry = 1; }
            if (retry == 1) {
                if (stall >= KLUG_STALL_MAX) { failed = 1; draining = 0; }
                stall = stall + 1;
            } else {
                if (m != 0) {
                    if (m != KLUG_EAGAIN) { failed = 1; }
                }
                draining = 0;
            }
        }
    }
    t = klug_emit_lines(min_level, buf, off, KLUG_SRC_KMSG, writer, mode);
    if (t < 0) { return klug_emit_done(min_level, t, total); }
    tagged = tagged + t;
    if (gap == 1) {
        klug_err_line("klug: the kernel overwrote /dev/kmsg records before klug reached them —");
        klug_err_line("      the dump has a GAP (the log moved faster than it was read).");
    }
    if (failed == 1) {
        klug_err_line("klug: kernel log read failed — the dump is INCOMPLETE");
        return 1;
    }
    return klug_emit_done(min_level, tagged, total);
}

# Write the lines of `buf[0..n)` that score at or above `min_level` under the `src`
# lens, through `writer` (see klug_write_loop) with zero-return policy `mode`.
# Returns 0 when every selected byte was accepted (a filter that selects NOTHING is
# still 0 — it is reported on stderr, not in the exit code), 1 on a write failure.
# Pure over its arguments: the harness drives it with a synthetic log and the
# scripted fake writer, which is how the run coalescing, the trailing partial line
# and the continuation-state threading are pinned without a /dev/kmsg. It is
# klug_emit_lines then klug_emit_done: the whole log in ONE buffer (the agnos ring).
fn klug_emit(min_level, buf, n, src, writer, mode): i64 {
    return klug_emit_done(min_level, klug_emit_lines(min_level, buf, n, src, writer, mode), n);
}

# The verdict on a dump: `t` is what klug_emit_lines returned (summed over the batches
# when the log came in several) and `n` the bytes the log held. Says on stderr what the
# exit code cannot — an incomplete dump, or a filter that matched nothing because the
# log carries no tags — and returns the exit code: 1 on a write failure, else 0.
fn klug_emit_done(min_level, t, n): i64 {
    if (t < 0) {
        klug_err_line("klug: stdout write failed — the dump is INCOMPLETE");
        return 1;
    }
    if (n <= 0) { return 0; }
    if (min_level == KLUG_LVL_ALL) { return 0; }
    # ⛔ A FILTER THAT MATCHED NOTHING BECAUSE THERE IS NOTHING TO MATCH IS NOT "no warnings".
    # Said on stderr, so stdout stays byte-exact for `klug -w | grep …` and the exit code stays 0
    # (this is a diagnostic about the corpus, not a failure of the dump).
    if (t == 0) {
        klug_err_line("klug: no severity-tagged lines in the log — this filter matched nothing");
        klug_err_line("      because the log carries no severity tags ([I]/[W]/[E] on agnos, a");
        klug_err_line("      <pri> on /dev/kmsg), NOT because there are no warnings. Use a bare");
        klug_err_line("      `klug` (or `klug | grep -i panic`) instead.");
    }
    return 0;
}

# Write the lines of `buf[0..n)` that score at or above `min_level` under the `src` lens
# through `writer` with policy `mode` — klug_emit without the verdict, so a log that
# arrives in batches (klug_kmsg_drain) can be emitted piece by piece and judged once.
# Returns the number of severity-tagged lines seen (>= 0; the unfiltered fast path does
# not count them and returns 0), or -1 on a write failure.
fn klug_emit_lines(min_level, buf, n, src, writer, mode): i64 {
    if (n <= 0) { return 0; }
    var rc = 0;
    # Fast path: no filtering → one write of the whole log.
    if (min_level == KLUG_LVL_ALL) {
        if (klug_write_loop(writer, mode, buf, n) != 0) { return 0 - 1; }
        return 0;
    }
    # Filtered: emit line-by-line, dropping lines below min_level. Adjacent passing
    # lines are contiguous in buf, so they are coalesced into ONE write: a run is
    # held open across consecutive passing lines and flushed when a dropped line
    # (or the end) breaks it. Byte-for-byte identical output to a per-line emit,
    # but 1 write instead of up to ~2400 — and on agnos each of those writes takes
    # fs_spin_lock and drives a full ext2 read-modify-write to the device.
    var i = 0;
    var start = 0;
    var run_start = 0 - 1;                              # -1 = no run open
    var run_end = 0;
    var tagged = 0;                                     # lines carrying ANY recognized severity tag
    var last_level = KLUG_LVL_ALL;                      # the last record's level — /dev/kmsg continuations inherit it
    while (i < n) {
        if (load8(buf + i) == 10) {                    # '\n' = 10
            tagged = tagged + klug_has_level_tag(buf + start, i - start + 1, src);
            last_level = klug_line_level(buf + start, i - start + 1, src, last_level);
            if (last_level >= min_level) {
                if (run_start < 0) { run_start = start; }
                run_end = i + 1;
            } else {
                if (run_start >= 0) {
                    if (klug_write_loop(writer, mode, buf + run_start, run_end - run_start) != 0) { rc = 1; }
                    run_start = 0 - 1;
                }
            }
            start = i + 1;
        }
        if (rc != 0) { i = n; } else { i = i + 1; }
    }
    if (rc == 0) {
        if (start < n) {                                # trailing partial line
            tagged = tagged + klug_has_level_tag(buf + start, n - start, src);
            last_level = klug_line_level(buf + start, n - start, src, last_level);
            if (last_level >= min_level) {
                if (run_start < 0) { run_start = start; }
                run_end = n;
            }
        }
        if (run_start >= 0) {
            if (klug_write_loop(writer, mode, buf + run_start, run_end - run_start) != 0) { rc = 1; }
        }
    }
    if (rc != 0) { return 0 - 1; }
    return tagged;
}
