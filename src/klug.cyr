# klug.cyr — the klug reader: kernel-log dump + optional severity lens.
#
# klug is the *Kernel Logs Unified Grep* subsystem. The kernel half (the agnos
# kernel's `core/klug.cyr`) unifies every line of kernel output into one 64 KB
# ring buffer; this is the userland half — a sovereign `dmesg` that copies that
# ring to stdout. Filtering past the severity lens stays the shell's job:
# `klug | grep panic`. The kernel UNIFIES, GREP stays userland.
#
# Pure helpers + the dump routine live here (no top-level execution) so the test
# harness can include the module. `src/main.cyr` is the entry. The libs this
# module uses (syscalls / io / string) are included by main.cyr and the harness
# before this file, per the project-include convention.

# main.cyr declares `var klug_buf[KLUG_RING_WORDS]`, so this enum IS the buffer's
# extent. A `var X[N]` is N×u64, so the buffer size and the byte count below can no
# longer drift apart silently — and the harness (which includes this file but not
# main.cyr, and so cannot see klug_buf at all) can cross-check the two.
enum KlugRing { KLUG_RING_WORDS = 8192; }   # ×u64 = 65536 B

# The agnos klug ring is 64 KB. `klug`#36 fills up to this many bytes (oldest→
# newest; a smaller buffer would get the newest-N tail, but we always pass the
# full ring size so one read drains it all). Kept as an independent literal on
# purpose: the cross-check in tests/klug.tcyr only has teeth while this and
# KLUG_RING_WORDS are stated separately.
var KLUG_RING_BYTES = 65536;

# Minimum-severity filter, ascending.
var KLUG_LVL_ALL  = 0;   # show everything (default)
var KLUG_LVL_WARN = 1;   # warnings + errors
var KLUG_LVL_ERR  = 2;   # errors only

# The kernel's klug_info/klug_warn/klug_err prefix lines with "[I] " / "[W] " /
# "[E] " (see core/klug.cyr). Return the severity of a line beginning at `p`
# (length `len`): 2=err, 1=warn, 0=info/plain. Lines without a recognized prefix
# (boot lines, raw kprintln output) are level 0, exactly like "[I] ": they appear
# in the default dump, but -w/-e DROP them, because the gate is level >= min_level.
# That holds on agnos too — a raw kprintln panic banner carries no prefix, so hunt
# one with `klug | grep -i panic`, not `klug -e`.
fn klug_level_of(p, len): i64 {
    if (len < 4) { return KLUG_LVL_ALL; }
    if (load8(p) != 91) { return KLUG_LVL_ALL; }       # '[' = 91
    if (load8(p + 2) != 93) { return KLUG_LVL_ALL; }   # ']' = 93
    var c = load8(p + 1);
    if (c == 69) { return KLUG_LVL_ERR; }              # 'E' = 69
    if (c == 87) { return KLUG_LVL_WARN; }             # 'W' = 87
    return KLUG_LVL_ALL;                               # 'I' or anything else
}

# Does this line carry a RECOGNIZED level tag at all? Distinct from klug_level_of,
# which cannot answer it: that fn returns KLUG_LVL_ALL (0) both for a real "[I] "
# and for a line with no tag whatsoever, because both must appear in a bare dump.
#
# ⛔⛔ WHY THIS EXISTS — `-w`/`-e` COULD REPORT "NO WARNINGS" ON A KERNEL THAT HAS NO
# LENS AT ALL, AND THAT IS THE STATE AGNOS SHIPS IN TODAY. The kernel's klug_info/
# klug_warn/klug_err have exactly THREE call sites and all three sit inside
# `#ifdef EXEC_SELFTEST` (agnos kernel/core/main.cyr:2737-2739, guarded 2589-3038),
# which is off in every production build. So a real boot log contains ZERO tagged
# lines, every line scores level 0, `klug -w` prints nothing and exits 0 — and
# "this box logged no warnings" is indistinguishable from "this filter is a no-op".
# A tool that cannot tell those apart is worse than one without the flag.
#
# ⚠ AND IT IS ABOUT TO MATTER MORE, NOT LESS. The lens is a FIXED-OFFSET test — '['
# at byte 0, ']' at byte 2 — so ANY field prepended to the line disarms it silently.
# A Linux-style "[    4.123456] " uptime prefix is the live proposal for the agnos
# kernel log; the day it lands, every line here scores 0. This counter is what turns
# that from a silent false negative into a message on stderr.
fn klug_has_level_tag(p, len): i64 {
    if (len < 4) { return 0; }
    if (load8(p) != 91) { return 0; }                  # '[' = 91
    if (load8(p + 2) != 93) { return 0; }              # ']' = 93
    var c = load8(p + 1);
    if (c == 69) { return 1; }                         # 'E'
    if (c == 87) { return 1; }                         # 'W'
    if (c == 73) { return 1; }                         # 'I'
    return 0;
}

fn klug_usage(): i64 {
    println("klug — dump the AGNOS kernel log (the klug unified ring buffer).");
    println("");
    println("usage: klug [-w|--warn] [-e|--err] [-h|--help]");
    println("  (no flags)   dump the whole kernel log");
    println("  -w, --warn   only warnings and errors ([W]/[E])");
    println("  -e, --err    only errors ([E])");
    println("  -h, --help   this help");
    println("");
    println("filter further with the shell: klug | grep <pattern>");
    # ⚠ AGNOS ONLY — reading the log CONSUMES it, unless you redirect. fd 1 is a
    # VFS_DEVICE, so klug's own write(1,…) lands in vfs_write's device arm →
    # dev_write → serial_dev_write (core/devs.cyr) → kprint → klug_append: every
    # console-bound ring-3 byte is appended to the very ring klug#36 just read.
    # The dump is up to KLUG_RING_BYTES and the ring is exactly KLUG_RING_BYTES,
    # so a console dump re-appends the whole log to itself; while the ring is
    # still short of full (a ~20 KB boot log) that DOUBLES it, and the second
    # dump wraps and takes the boot head with it. Redirecting is not a nicety —
    # it is how the log survives being read. A pipe is safe for the same reason
    # the redirect is: a pipe fd takes vfs_write's VFS_PIPE arm, never kprint, so
    # only grep's matched lines are console-bound.
    # ⛔ Do NOT drop this note when the kernel-side fix lands — suppressing the
    # tap for klug#36's own output fixes THIS tool, not the property (any large
    # console dump still ages the ring), and klug ships as a committed binary
    # that is staged onto older kernels by agnos/scripts/burn/stage-tools.sh.
    # Tracked agnos-side: docs/development/state.md OPEN, roadmap.md (HID row),
    # and the `run /bin/klug > /f.txt` note at core/syscall.cyr:442-444.
    #ifdef CYRIUS_TARGET_AGNOS
    println("");
    println("on AGNOS, redirect instead of dumping to the console:");
    println("      run /bin/klug > /f.txt");
    println("  the console write path feeds the klug ring, so dumping the log to");
    println("  the console re-appends the dump to the log and ages the oldest boot");
    println("  lines out. Piping is safe: klug | grep writes into the pipe, and");
    println("  only the matched lines reach the console.");
    #endif
    return 0;
}

# -EINTR. klug installs no signal handlers, so this is belt-and-braces.
var KLUG_EINTR = 0 - 4;
# Bound on consecutive no-progress agnos yields before we call the consumer gone.
var KLUG_STALL_MAX = 100000;

# Write EXACTLY `len` bytes from `p` to stdout, looping over short writes.
# Returns 0 when all `len` bytes were accepted, 1 otherwise.
#
# WHY THIS EXISTS: a single write(1, buf, 65536) is not a promise of 65536 bytes.
#   · agnos `pipe_write` (kernel/core/vfs.cyr) refuses past PIPE_RING = 4080 and
#     returns a SHORT count on purpose — "a short return is the contract". So
#     `klug | grep panic`, the command klug's own help text calls safe, delivered
#     at most 4080 bytes of a 20–64 KB log until this loop existed.
#   · agnos `ext2_write_at` returns a PARTIAL count on ENOSPC, so `run /bin/klug >
#     /f.txt` on a full disk silently kept only the head. Linux does the same.
#   · The console arm is NOT affected: `serial_dev_write` (core/devs.cyr) chunks
#     internally and returns the full count — it was rewritten because of this very
#     bug, which the kernel worked around on that one arm and no other.
# A 0 return means DIFFERENT THINGS on the two targets and must not be merged: on
# agnos it is backpressure from a ring whose consumer has not been scheduled yet
# (retry after a yield), on Linux it is pathological (fail).
fn klug_write_all(p, len): i64 {
    var w = 0;
    var stall = 0;
    while (w < len) {
        var r = syscall(SYS_WRITE, 1, p + w, len - w);
        if (r > 0) { w = w + r; stall = 0; }
        else {
            #ifdef CYRIUS_TARGET_AGNOS
            # -1 is a real error (bad fd / write end closed) — stop, do not spin.
            if (r < 0) { return 1; }
            # r == 0: pipe ring full. Yield so the consumer runs, and bound the
            # stall so a vanished consumer (`klug | head`) cannot hang klug forever
            # — agnos pipe_write gives the writer no reader-gone signal.
            if (stall >= KLUG_STALL_MAX) { return 1; }
            stall = stall + 1;
            sys_sched_yield();
            #endif
            #ifndef CYRIUS_TARGET_AGNOS
            if (r == 0) { return 1; }
            if (r != KLUG_EINTR) { return 1; }   # -EINTR retries; anything else is fatal
            #endif
        }
    }
    return 0;
}

# Diagnostics go to fd 2: fd 1 carries the dump, so error prose on stdout lands
# inside `klug > f.txt` and gets piped into `klug | grep`. On agnos a failed
# fd-1 write is precisely the case where fd 1 cannot take more bytes anyway.
fn klug_err_line(s: cstring): i64 {
    syscall(SYS_WRITE, 2, s, strlen(s));
    syscall(SYS_WRITE, 2, "\n", 1);
    return 0;
}

# Read the kernel log into `buf` (must be KLUG_RING_BYTES bytes) and write the
# lines at or above `min_level` to stdout. Returns 0 on success, 1 on read
# failure or an incomplete write.
fn klug_dump(min_level, buf): i64 {
    var n = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    # Native: klug#36 copies the klug ring into buf and returns bytes written. It
    # only ever copies klug_buf, never other kernel memory, so it can't leak.
    n = sys_klug(buf, KLUG_RING_BYTES);
    if (n < 0) { klug_err_line("klug: kernel log read failed"); return 1; }
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # Dev-host dogfooding: the klug ring is agnos-only, so dump the Linux kernel
    # ring via /dev/kmsg. The node is mode 0644, but `kernel.dmesg_restrict=1` (the
    # default on systemd distros) makes open() return EPERM for non-root anyway, so
    # an unprivileged run normally lands in the branch below — that is the host
    # policy, not a klug failure. O_RDONLY|O_NONBLOCK so read returns once the
    # buffer is drained (EAGAIN) instead of blocking for future messages; one
    # record per read, accumulated into buf up to capacity.
    var fd = sys_open("/dev/kmsg", 2048, 0);            # 2048 = O_NONBLOCK (0o4000)
    if (fd < 0) {
        klug_err_line("klug: kernel log unavailable on this host (open /dev/kmsg failed);");
        klug_err_line("      needs root, or kernel.dmesg_restrict=0.");
        klug_err_line("      the native reader is agnos klug#36 — build with `cyrius build --agnos`.");
        return 1;
    }
    var off = 0;
    var draining = 1;
    while (draining == 1) {
        if (off >= KLUG_RING_BYTES) { draining = 0; }
        else {
            var m = syscall(SYS_READ, fd, buf + off, KLUG_RING_BYTES - off);
            if (m <= 0) { draining = 0; }
            else { off = off + m; }
        }
    }
    syscall(SYS_CLOSE, fd);
    n = off;
    #endif
    if (n <= 0) { return 0; }
    var rc = 0;
    # Fast path: no filtering → one write_all of the whole ring.
    if (min_level == KLUG_LVL_ALL) {
        rc = klug_write_all(buf, n);
        if (rc != 0) { klug_err_line("klug: stdout write failed — the dump is INCOMPLETE"); }
        return rc;
    }
    # Filtered: emit line-by-line, dropping lines below min_level. Adjacent passing
    # lines are contiguous in buf, so they are coalesced into ONE write: a run is
    # held open across consecutive passing lines and flushed when a dropped line
    # (or the end) breaks it. Byte-for-byte identical output to a per-line emit,
    # but 1 write instead of up to ~2400 — and on agnos each of those writes takes
    # fs_spin_lock and drives a full ext2 read-modify-write to the device.
    var i = 0;
    var start = 0;
    var run_start = 0 - 1;                              # -1 = no run open
    var run_end = 0;
    var tagged = 0;                                     # lines carrying ANY recognized [I]/[W]/[E]
    while (i < n) {
        if (load8(buf + i) == 10) {                    # '\n' = 10
            tagged = tagged + klug_has_level_tag(buf + start, i - start + 1);
            if (klug_level_of(buf + start, i - start + 1) >= min_level) {
                if (run_start < 0) { run_start = start; }
                run_end = i + 1;
            } else {
                if (run_start >= 0) {
                    if (klug_write_all(buf + run_start, run_end - run_start) != 0) { rc = 1; }
                    run_start = 0 - 1;
                }
            }
            start = i + 1;
        }
        if (rc != 0) { i = n; } else { i = i + 1; }
    }
    if (rc == 0) {
        if (start < n) {                                # trailing partial line
            tagged = tagged + klug_has_level_tag(buf + start, n - start);
            if (klug_level_of(buf + start, n - start) >= min_level) {
                if (run_start < 0) { run_start = start; }
                run_end = n;
            }
        }
        if (run_start >= 0) {
            if (klug_write_all(buf + run_start, run_end - run_start) != 0) { rc = 1; }
        }
    }
    if (rc != 0) { klug_err_line("klug: stdout write failed — the dump is INCOMPLETE"); }
    # ⛔ A FILTER THAT MATCHED NOTHING BECAUSE THERE IS NOTHING TO MATCH IS NOT "no warnings".
    # Said on stderr, so stdout stays byte-exact for `klug -w | grep …` and the exit code stays 0
    # (this is a diagnostic about the corpus, not a failure of the dump).
    if (tagged == 0) {
        klug_err_line("klug: no [I]/[W]/[E]-tagged lines in the ring — this filter matched nothing");
        klug_err_line("      because the log carries no severity tags, NOT because there are no");
        klug_err_line("      warnings. Use a bare `klug` (or `klug | grep -i panic`) instead.");
    }
    return rc;
}
