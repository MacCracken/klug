# main.cyr — klug entry point. Parses the severity flag and dumps the kernel
# log. The reader logic lives in src/klug.cyr.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/args.cyr"
include "src/klug.cyr"

# 64 KB read buffer matching the kernel ring. A module-global `var X[N]`
# allocates N×u64, so var[8192] = 65536 bytes = KLUG_RING_BYTES (64 KB, matches the kernel ring).
var klug_buf[8192];

fn main(): i64 {
    args_init();
    var min_level = KLUG_LVL_ALL;
    var ac = argc();
    var i = 1;
    while (i < ac) {
        var a = argv(i);
        if (streq(a, "-h") == 1)     { return klug_usage(); }
        if (streq(a, "--help") == 1) { return klug_usage(); }
        if (streq(a, "-e") == 1)     { min_level = KLUG_LVL_ERR; }
        if (streq(a, "--err") == 1)  { min_level = KLUG_LVL_ERR; }
        if (streq(a, "-w") == 1)     { min_level = KLUG_LVL_WARN; }
        if (streq(a, "--warn") == 1) { min_level = KLUG_LVL_WARN; }
        i = i + 1;
    }
    return klug_dump(min_level, &klug_buf);
}

# Bare-call entry. Historically load-bearing: under cyrius 6.1.14 a `var = main()`
# top-level ran main as a gvar-init BEFORE the agnos init-rsp capture, so
# argc()/argv() read 0/null (klug 0.1.1 fixed that by switching to this bare
# statement). 6.1.32 moved the capture to an entry-landing r15 park that precedes
# all gvar-init code (see lib/args_agnos.cyr), so the workaround is no longer
# required at the 6.5.35 pin — but it is still correct, and the bare form is what
# the agnos exec path expects, so it stays.
fn _agnos_entry(): i64 {
    var r = main();
    syscall(SYS_EXIT, r);
    return 0;
}
_agnos_entry();
